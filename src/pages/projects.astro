---
import Navbar from '../components/Navbar.astro';

const title = 'Projects - Hanshan';
const description = '精选项目作品，涵盖全栈开发、WebGL 可视化、AI 工具等领域';

const projects = [
  {
    slug: 'ai-gateway-lite',
    title: 'ai-gateway-lite',
    excerpt: '轻量 AI 网关，多模型路由 + 降级 + 预算控制',
    tags: ['TypeScript', 'AI', 'API'],
    hue: 220,
    speed: 1.2,
    size: 'large',
  },
  {
    slug: 'ai-memory',
    title: 'ai-memory',
    excerpt: '把 Cursor 对话变成结构化知识库',
    tags: ['TypeScript', 'AI', 'Knowledge'],
    hue: 280,
    speed: 1.0,
    size: 'medium',
  },
  {
    slug: 'shader-playground',
    title: 'Shader Playground',
    excerpt: 'WebGL Shader 实时编辑器与效果预览',
    tags: ['WebGL', 'GLSL', 'Visualization'],
    hue: 180,
    speed: 1.5,
    size: 'medium',
  },
  {
    slug: 'particle-system',
    title: 'Particle System',
    excerpt: '高性能粒子系统，支持百万级粒子渲染',
    tags: ['WebGL', 'Animation', 'Performance'],
    hue: 320,
    speed: 1.8,
    size: 'small',
  },
  {
    slug: 'realtime-charts',
    title: 'Realtime Charts',
    excerpt: '实时数据可视化图表库',
    tags: ['React', 'Visualization', 'Data'],
    hue: 140,
    speed: 0.8,
    size: 'small',
  },
  {
    slug: 'micro-frontends',
    title: 'Micro Frontends',
    excerpt: '微前端架构实践与组件库',
    tags: ['React', 'Architecture', 'Monorepo'],
    hue: 60,
    speed: 1.0,
    size: 'large',
  },
];
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="cursor"></div>
    <div id="cursor-follower"></div>

    <canvas id="shader-canvas"></canvas>

    <Navbar activePage="projects" />

    <section id="hero">
      <div class="hero-content">
        <div class="hero-badge">WORKS</div>
        <h1 class="hero-title">
          <span class="hero-line">精选</span>
          <span class="hero-line">项目</span>
        </h1>
        <p class="hero-description">
          探索全栈工程、WebGL 可视化与 AI 工具的实践作品。每一个项目都是对技术边界的探索与突破。
        </p>
      </div>
    </section>

    <section id="projects">
      <div class="bento-grid">
        {
          projects.map((project, index) => (
            <a
              href={`/project/${project.slug}`}
              class={`bento-card ${project.size} reveal`}
              style={{ animationDelay: `${index * 0.1}s` }}
            >
              <canvas class="card-canvas" data-hue={project.hue} data-speed={project.speed} />
              <div class="card-content">
                <div class="card-tags">
                  {project.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <h3 class="card-title">{project.title}</h3>
                <p class="card-excerpt">{project.excerpt}</p>
                <span class="card-arrow">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="site-footer">
      <div class="footer-content">
        <span class="footer-text">© 2026 Conor Liu. Built with code & coffee.</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/articles">Blog</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg-primary: #050505;
    --bg-secondary: #0b0b0d;
    --bg-card: rgba(255, 255, 255, 0.03);
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.15);

    --text-primary: #f5f5f5;
    --text-secondary: #d4d4d8;
    --text-muted: #a1a1aa;
    --text-subtle: #71717a;

    --accent-blue: #60a5fa;
    --accent-violet: #8b5cf6;
    --accent-cyan: #22d3ee;
    --gradient: linear-gradient(135deg, #60a5fa, #8b5cf6, #22d3ee);
    --gradient-text: linear-gradient(135deg, #60a5fa, #8b5cf6);

    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', 'Space Mono', monospace;
    --font-display: 'Bebas Neue', sans-serif;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  html {
    scroll-behavior: smooth;
    cursor: none;
  }

  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.75;
    overflow-x: hidden;
    min-height: 100vh;
  }

  /* CURSOR */
  #cursor {
    position: fixed;
    width: 10px;
    height: 10px;
    background: var(--accent-blue);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition:
      width 0.2s,
      height 0.2s,
      background 0.2s;
    mix-blend-mode: difference;
  }

  #cursor-follower {
    position: fixed;
    width: 40px;
    height: 40px;
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: all 0.12s ease;
    mix-blend-mode: difference;
  }

  /* NOISE OVERLAY */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
  }

  /* SHADER CANVAS */
  #shader-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    opacity: 0.2;
  }

  /* HERO */
  #hero {
    padding: 12rem 2rem 6rem;
    text-align: center;
    position: relative;
    z-index: 10;
  }

  .hero-content {
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent-blue);
    margin-bottom: 1.5rem;
    display: inline-block;
  }

  .hero-title {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-line {
    display: inline-block;
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .hero-line:nth-child(1) {
    animation-delay: 0.1s;
  }
  .hero-line:nth-child(2) {
    animation-delay: 0.3s;
    background: var(--gradient-text);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-description {
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.8;
  }

  /* BENTO GRID */
  #projects {
    padding: 2rem 2rem 6rem;
    position: relative;
    z-index: 10;
  }

  .bento-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, minmax(200px, auto));
    gap: 1rem;
  }

  .bento-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: var(--text-primary);
    transition: all var(--transition-normal);
    display: flex;
    align-items: flex-end;
  }

  .bento-card:hover {
    border-color: var(--accent-blue);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(96, 165, 250, 0.1);
  }

  .bento-card.large {
    grid-column: span 3;
    grid-row: span 2;
  }

  .bento-card.medium {
    grid-column: span 2;
    grid-row: span 2;
  }

  .bento-card.small {
    grid-column: span 1;
    grid-row: span 1;
  }

  .card-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.3;
    transition: opacity var(--transition-normal);
  }

  .bento-card:hover .card-canvas {
    opacity: 0.5;
  }

  .card-content {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
    width: 100%;
  }

  .card-tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0.25rem 0.6rem;
    background: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.15);
    border-radius: 999px;
    color: var(--text-muted);
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    transition: color var(--transition-fast);
  }

  .bento-card:hover .card-title {
    color: var(--accent-blue);
  }

  .card-excerpt {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-arrow {
    font-size: 1rem;
    color: var(--accent-blue);
    opacity: 0;
    transform: translateX(-10px);
    transition: all var(--transition-normal);
    display: inline-block;
  }

  .bento-card:hover .card-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* SITE FOOTER */
  .site-footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: 2.5rem 2rem;
    position: relative;
    z-index: 10;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-subtle);
    letter-spacing: 0.05em;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-subtle);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  /* REVEAL ANIMATION */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (max-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(6, minmax(180px, auto));
    }
    .bento-card.large {
      grid-column: span 4;
      grid-row: span 2;
    }
    .bento-card.medium {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bento-card.small {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 768px) {
    #hero {
      padding: 8rem 1rem 4rem;
    }
    .bento-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .bento-card.large,
    .bento-card.medium,
    .bento-card.small {
      grid-column: span 1;
      grid-row: span 1;
      min-height: 200px;
    }
    .footer-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>

<script>
  // ─── SHADER BACKGROUND ───────────────────────────────────────────
  const sc = document.getElementById('shader-canvas');
  const sgl = sc.getContext('webgl') || sc.getContext('experimental-webgl');

  function resizeShader() {
    sc.width = innerWidth;
    sc.height = innerHeight;
    if (sgl) sgl.viewport(0, 0, sc.width, sc.height);
  }
  resizeShader();
  window.addEventListener('resize', resizeShader);

  if (sgl) {
    const gl = sgl;
    const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
    const fs = `precision highp float;
uniform float t;uniform vec2 r;uniform vec2 m;
vec3 pal(float t,vec3 a,vec3 b,vec3 c,vec3 d){return a+b*cos(6.28318*(c*t+d));}
float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
void main(){
  vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
  vec2 mu=(m/r-.5)*2.;
  float time=t*.2;
  vec2 q=vec2(fbm(uv+vec2(0,0)),fbm(uv+vec2(5.2,1.3)));
  vec2 p2=uv+.5*q+vec2(1.7+sin(time*.5)*mu.x*.2,9.2+cos(time*.3)*mu.y*.2);
  float f=fbm(p2);
  vec3 col=pal(f+time*.05,vec3(.3,.3,.4),vec3(.2,.2,.3),vec3(.8,.8,1.),vec3(0,.1,.2));
  col=mix(col,vec3(.2,.1,.3),clamp(f*f*2.,0.,1.));
  col*=1.-length(uv)*.3;
  gl_FragColor=vec4(col*.25,1);
}`;

    function mkShader(gl, type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }

    const prog = gl.createProgram();
    gl.attachShader(prog, mkShader(gl, gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, mkShader(gl, gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const tl = gl.getUniformLocation(prog, 't');
    const rl = gl.getUniformLocation(prog, 'r');
    const ml = gl.getUniformLocation(prog, 'm');

    let mx = 0,
      my = 0;
    document.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    });

    function animShader(ts) {
      gl.uniform1f(tl, ts * 0.001);
      gl.uniform2f(rl, sc.width, sc.height);
      gl.uniform2f(ml, mx, my);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      requestAnimationFrame(animShader);
    }
    requestAnimationFrame(animShader);
  }

  // ─── CURSOR ANIMATION ───────────────────────────────────────────
  const cur = document.getElementById('cursor');
  const fol = document.getElementById('cursor-follower');
  let fx = 0,
    fy = 0,
    cx2 = 0,
    cy2 = 0;

  document.addEventListener('mousemove', (e) => {
    cx2 = e.clientX;
    cy2 = e.clientY;
    cur.style.left = cx2 + 'px';
    cur.style.top = cy2 + 'px';
  });

  function animCursor() {
    fx += (cx2 - fx) * 0.15;
    fy += (cy2 - fy) * 0.15;
    fol.style.left = fx + 'px';
    fol.style.top = fy + 'px';
    requestAnimationFrame(animCursor);
  }
  animCursor();

  document.querySelectorAll('a, .magnetic').forEach((el) => {
    el.addEventListener('mouseenter', () => {
      cur.style.width = '24px';
      cur.style.height = '24px';
      cur.style.background = '#60A5FA';
      fol.style.transform = 'translate(-50%, -50%) scale(1.5)';
      fol.style.borderColor = 'rgba(96, 165, 250, 0.5)';
    });
    el.addEventListener('mouseleave', () => {
      cur.style.width = '10px';
      cur.style.height = '10px';
      cur.style.background = '#60A5FA';
      fol.style.transform = 'translate(-50%, -50%) scale(1)';
      fol.style.borderColor = 'rgba(255, 255, 255, 0.2)';
    });
  });

  // ─── CARD CANVASES ───────────────────────────────────────────
  document.querySelectorAll('.card-canvas').forEach((canvas) => {
    const c = canvas;
    const gl = c.getContext('webgl') || c.getContext('experimental-webgl');
    if (!gl) return;

    const hue = parseFloat(c.dataset.hue) || 220;
    const speed = parseFloat(c.dataset.speed) || 1;

    function resizeCardCanvas() {
      c.width = c.offsetWidth;
      c.height = c.offsetHeight;
      gl.viewport(0, 0, c.width, c.height);
    }
    resizeCardCanvas();
    window.addEventListener('resize', resizeCardCanvas);

    const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
    const fs = `precision highp float;
uniform float t;uniform vec2 r;
float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<4;i++){v+=a*sn(p);p=p*2.2+vec2(1.7,9.2);a*=.5;}return v;}
void main(){
  vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
  float time=t*${speed};
  float f=fbm(uv+vec2(time*.1,0));
  float g=fbm(uv+vec2(0,time*.15));
  float c=sin(f*10.+time)*.5+.5;
  vec3 col=vec3(c*.3,c*.2,c*.4);
  col=mix(col,vec3(.1,.1,.15),smoothstep(.3,.8,length(uv)));
  gl_FragColor=vec4(col,1);
}`;

    const prog = gl.createProgram();
    gl.attachShader(prog, mkShader(gl, gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, mkShader(gl, gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    function mkShader(gl, type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const tl = gl.getUniformLocation(prog, 't');
    const rl = gl.getUniformLocation(prog, 'r');

    function anim(ts) {
      gl.uniform1f(tl, ts * 0.001);
      gl.uniform2f(rl, c.width, c.height);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      requestAnimationFrame(anim);
    }
    requestAnimationFrame(anim);
  });

  // ─── SCROLL REVEAL ───────────────────────────────────────────
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => {
            e.target.style.transition =
              'opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)';
            e.target.style.opacity = '1';
            e.target.style.transform = 'translateY(0)';
          }, i * 80);
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -30px 0px' },
  );

  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
