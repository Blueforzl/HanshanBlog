---
import Navbar from '../components/Navbar.astro';

const title = "Lab - Hanshan";
const description = "动效实验室，探索 WebGL、动画与交互的边界";

const experiments = [
  {
    id: 'particles',
    title: '粒子系统',
    category: 'WebGL',
    description: '高性能粒子系统，支持百万级粒子实时渲染',
    demo: 'particles'
  },
  {
    id: 'shader',
    title: 'Shader 流体',
    category: 'GLSL',
    description: '实时流体模拟，基于 Simplex Noise',
    demo: 'shader'
  },
  {
    id: 'waves',
    title: '波形可视化',
    category: 'Canvas',
    description: '音频驱动的波形动画效果',
    demo: 'waves'
  },
  {
    id: 'morphing',
    title: '形态变换',
    category: 'Animation',
    description: 'SVG 路径变形动画效果',
    demo: 'morphing'
  }
];
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Bebas+Neue&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-primary: #050505;
        --bg-secondary: #111113;
        --bg-card: rgba(255,255,255,0.04);
        --border-color: rgba(255,255,255,0.08);
        --text-primary: #F5F5F5;
        --text-secondary: #D4D4D8;
        --text-subtle: #A1A1AA;
        --text-muted: #71717A;
        --accent-blue: #60A5FA;
        --accent-violet: #8B5CF6;
        --accent-cyan: #22D3EE;
        --transition-fast: 0.2s ease;
        --transition-normal: 0.4s ease;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: var(--bg-primary);
        color: var(--text-primary);
        line-height: 1.6;
        overflow-x: hidden;
        cursor: none;
      }

      #shader-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        opacity: 0.5;
        pointer-events: none;
      }

      #cursor {
        position: fixed;
        width: 10px;
        height: 10px;
        background: var(--accent-blue);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-50%, -50%);
        transition: width 0.2s, height 0.2s, background 0.2s;
        mix-blend-mode: difference;
      }

      #cursor-follower {
        position: fixed;
        width: 40px;
        height: 40px;
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9998;
        transform: translate(-50%, -50%);
        transition: transform 0.15s ease-out, border-color 0.2s;
      }



      #hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8rem 2rem 4rem;
        position: relative;
        z-index: 1;
      }

      .hero-content {
        text-align: center;
        max-width: 800px;
      }

      .hero-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: rgba(96, 165, 250, 0.1);
        border: 1px solid rgba(96, 165, 250, 0.2);
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--accent-blue);
        margin-bottom: 1.5rem;
      }

      .hero-title {
        font-size: clamp(3rem, 12vw, 5rem);
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1.5rem;
      }

      .hero-line {
        display: block;
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-violet), var(--accent-cyan));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero-description {
        font-size: 1.25rem;
        color: var(--text-secondary);
        max-width: 600px;
        margin: 0 auto;
      }

      #experiments {
        padding: 8rem 2rem;
        position: relative;
        z-index: 1;
        background: rgba(5, 5, 5, 0.8);
      }

      .section-header {
        text-align: center;
        margin-bottom: 4rem;
      }

      .section-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--accent-blue);
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .section-title {
        font-size: clamp(2rem, 6vw, 3.5rem);
        font-weight: 700;
        color: var(--text-primary);
      }

      .experiments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .experiment-card {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.3s ease, border-color 0.3s ease;
      }

      .experiment-card:hover {
        transform: translateY(-4px);
        border-color: rgba(96, 165, 250, 0.3);
      }

      .exp-canvas {
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, rgba(96, 165, 250, 0.1), rgba(139, 92, 246, 0.1));
      }

      .exp-overlay {
        padding: 1.5rem;
      }

      .exp-category {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(96, 165, 250, 0.1);
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--accent-blue);
        margin-bottom: 0.75rem;
      }

      .exp-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
      }

      .exp-description {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        line-height: 1.6;
      }

      .exp-button {
        padding: 0.5rem 1.25rem;
        background: transparent;
        border: 1px solid rgba(96, 165, 250, 0.3);
        border-radius: 6px;
        color: var(--accent-blue);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--transition-fast);
      }

      .exp-button:hover {
        background: rgba(96, 165, 250, 0.1);
        border-color: var(--accent-blue);
      }

      .demo-controls {
        max-width: 800px;
        margin: 4rem auto 0;
        padding: 2rem;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        text-align: center;
      }

      .demo-controls h3 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: var(--text-primary);
      }

      .demo-controls p {
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
      }

      .demo-controls button {
        margin: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-violet));
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast);
      }

      .demo-controls button:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(96, 165, 250, 0.3);
      }

      footer {
        padding: 4rem 2rem;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border-color);
        position: relative;
        z-index: 1;
      }

      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .footer-links {
        display: flex;
        gap: 2rem;
        list-style: none;
      }

      .footer-links a {
        color: var(--text-subtle);
        text-decoration: none;
        font-size: 0.875rem;
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--text-primary);
      }

      .footer-copyright {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      @media (max-width: 768px) {
        .hero-title {
          font-size: clamp(2rem, 10vw, 3.5rem);
        }
        .experiments-grid {
          grid-template-columns: 1fr;
        }
        .footer-content {
          flex-direction: column;
          gap: 1rem;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div id="cursor"></div>
    <div id="cursor-follower"></div>
    <canvas id="shader-canvas"></canvas>

    <Navbar activePage="lab" />

    <section id="hero">
      <div class="hero-content">
        <div class="hero-badge">LAB</div>
        <h1 class="hero-title">
          <span class="hero-line">动效</span>
          <span class="hero-line">实验室</span>
        </h1>
        <p class="hero-description">
          探索 WebGL、动画与交互的边界。这里是我实验和探索新技术的地方。
        </p>
      </div>
    </section>

    <section id="experiments">
      <div class="section-header">
        <span class="section-label">EXPERIMENTS</span>
        <h2 class="section-title">交互式演示</h2>
      </div>

      <div class="experiments-grid">
        {experiments.map((exp, index) => (
          <div class="experiment-card" style={{ animationDelay: `${index * 0.1}s` }} data-demo={exp.demo}>
            <canvas class="exp-canvas" id={`canvas-${exp.id}`}></canvas>
            <div class="exp-overlay">
              <span class="exp-category">{exp.category}</span>
              <h3 class="exp-title">{exp.title}</h3>
              <p class="exp-description">{exp.description}</p>
              <button class="exp-button">运行演示</button>
            </div>
          </div>
        ))}
      </div>

      <div class="demo-controls">
        <h3>实时演示</h3>
        <p>点击下方按钮查看动效演示</p>
        <button onclick="runParticleDemo()">粒子系统</button>
        <button onclick="runShaderDemo()">Shader 流体</button>
        <button onclick="runWaveDemo()">波形动画</button>
      </div>
    </section>

    <footer>
      <div class="footer-content">
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/articles">Blog</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/about">About</a></li>
        </ul>
        <div class="footer-copyright">
          2024 Conor Liu. All rights reserved.
        </div>
      </div>
    </footer>

    <script>
      const sc = document.getElementById('shader-canvas');
      const sgl = sc.getContext('webgl') || sc.getContext('experimental-webgl');

      function resizeShader() {
        sc.width = innerWidth;
        sc.height = innerHeight;
        if (sgl) sgl.viewport(0, 0, sc.width, sc.height);
      }
      resizeShader();
      window.addEventListener('resize', resizeShader);

      if (sgl) {
        const gl = sgl;
        const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
        const fs = `precision highp float;
          uniform float t;uniform vec2 r;uniform vec2 m;
          vec3 pal(float t,vec3 a,vec3 b,vec3 c,vec3 d){return a+b*cos(6.28318*(c*t+d));}
          float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
          float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
          float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
          void main(){
            vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
            vec2 mu=(m/r-.5)*2.;
            float time=t*.2;
            vec2 q=vec2(fbm(uv+vec2(0,0)),fbm(uv+vec2(5.2,1.3)));
            vec2 p2=uv+.5*q+vec2(1.7+sin(time*.5)*mu.x*.2,9.2+cos(time*.3)*mu.y*.2);
            float f=fbm(p2);
            vec3 col=pal(f+time*.05,vec3(.3,.3,.4),vec3(.2,.2,.3),vec3(.8,.8,1.),vec3(0,.1,.2));
            col=mix(col,vec3(.2,.1,.3),clamp(f*f*2.,0.,1.));
            col*=1.-length(uv)*.3;
            gl_FragColor=vec4(col*.25,1);
          }`;

        function mkShader(gl, type, src) {
          const s = gl.createShader(type);
          gl.shaderSource(s, src);
          gl.compileShader(s);
          return s;
        }

        const prog = gl.createProgram();
        gl.attachShader(prog, mkShader(gl, gl.VERTEX_SHADER, vs));
        gl.attachShader(prog, mkShader(gl, gl.FRAGMENT_SHADER, fs));
        gl.linkProgram(prog);
        gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,1,-1,-1,1,1,1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

        const tl = gl.getUniformLocation(prog, 't');
        const rl = gl.getUniformLocation(prog, 'r');
        const ml = gl.getUniformLocation(prog, 'm');

        let mx = 0, my = 0;
        document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });

        function animShader(ts) {
          gl.uniform1f(tl, ts * 0.001);
          gl.uniform2f(rl, sc.width, sc.height);
          gl.uniform2f(ml, mx, my);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          requestAnimationFrame(animShader);
        }
        requestAnimationFrame(animShader);
      }

      const cur = document.getElementById('cursor');
      const fol = document.getElementById('cursor-follower');
      let fx = 0, fy = 0, cx2 = 0, cy2 = 0;

      document.addEventListener('mousemove', e => {
        cx2 = e.clientX;
        cy2 = e.clientY;
        cur.style.left = cx2 + 'px';
        cur.style.top = cy2 + 'px';
      });

      function animCursor() {
        fx += (cx2 - fx) * 0.15;
        fy += (cy2 - fy) * 0.15;
        fol.style.left = fx + 'px';
        fol.style.top = fy + 'px';
        requestAnimationFrame(animCursor);
      }
      animCursor();

      document.querySelectorAll('a, button').forEach(el => {
        el.addEventListener('mouseenter', () => {
          cur.style.width = '24px';
          cur.style.height = '24px';
          fol.style.transform = 'translate(-50%, -50%) scale(1.5)';
          fol.style.borderColor = 'rgba(96, 165, 250, 0.5)';
        });
        el.addEventListener('mouseleave', () => {
          cur.style.width = '10px';
          cur.style.height = '10px';
          fol.style.transform = 'translate(-50%, -50%) scale(1)';
          fol.style.borderColor = 'rgba(255, 255, 255, 0.2)';
        });
      });

      function runParticleDemo() {
        const canvas = document.getElementById('canvas-particles');
        const ctx = canvas.getContext('2d');
        const particles = [];
        const particleCount = 100;

        for (let i = 0; i < particleCount; i++) {
          particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            vx: (Math.random() - 0.5) * 2,
            vy: (Math.random() - 0.5) * 2,
            size: Math.random() * 3 + 1
          });
        }

        function animate() {
          ctx.fillStyle = 'rgba(5, 5, 5, 0.1)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;

            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(96, 165, 250, 0.8)';
            ctx.fill();
          });

          requestAnimationFrame(animate);
        }
        animate();
      }

      function runShaderDemo() {
        const canvas = document.getElementById('canvas-shader');
        const gl = canvas.getContext('webgl');
        
        if (!gl) return;

        const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
        const fs = `precision highp float;
          uniform float t;
          uniform vec2 r;
          float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
          float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
          float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
          void main(){
            vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
            float f=fbm(uv+t*.2);
            vec3 col=vec3(f*.8+.2,f*.6+.2,f*.4+.2);
            gl_FragColor=vec4(col,1);
          }`;

        const prog = gl.createProgram();
        const s = gl.createShader(gl.VERTEX_SHADER);
        gl.shaderSource(s, vs);
        gl.compileShader(s);
        gl.attachShader(prog, s);

        const fsShader = gl.createShader(gl.FRAGMENT_SHADER);
        gl.shaderSource(fsShader, fs);
        gl.compileShader(fsShader);
        gl.attachShader(prog, fsShader);

        gl.linkProgram(prog);
        gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1,1,-1,-1,1,1,1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

        const tl = gl.getUniformLocation(prog, 't');
        const rl = gl.getUniformLocation(prog, 'r');

        function anim(ts) {
          gl.uniform1f(tl, ts * 0.001);
          gl.uniform2f(rl, canvas.width, canvas.height);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          requestAnimationFrame(anim);
        }
        anim(0);
      }

      function runWaveDemo() {
        const canvas = document.getElementById('canvas-waves');
        const ctx = canvas.getContext('2d');
        let time = 0;

        function animate() {
          ctx.fillStyle = 'rgba(5, 5, 5, 0.1)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          ctx.beginPath();
          ctx.moveTo(0, canvas.height / 2);

          for (let x = 0; x < canvas.width; x++) {
            const y = canvas.height / 2 + Math.sin(x * 0.02 + time) * 30 + Math.sin(x * 0.01 + time * 0.5) * 20;
            ctx.lineTo(x, y);
          }

          ctx.strokeStyle = 'rgba(96, 165, 250, 0.8)';
          ctx.lineWidth = 2;
          ctx.stroke();

          time += 0.05;
          requestAnimationFrame(animate);
        }
        animate();
      }
    </script>
  </body>
</html>