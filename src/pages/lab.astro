---
import Navbar from '../components/Navbar.astro';

const title = 'Lab - Hanshan';
const description = '动效实验室，探索 WebGL、动画与交互的边界';

const experiments = [
  {
    id: 'particles',
    title: '粒子系统',
    category: 'WebGL',
    description: '高性能粒子系统，支持百万级粒子实时渲染',
    demo: 'particles',
  },
  {
    id: 'shader',
    title: 'Shader 流体',
    category: 'GLSL',
    description: '实时流体模拟，基于 Simplex Noise',
    demo: 'shader',
  },
  {
    id: 'waves',
    title: '波形可视化',
    category: 'Canvas',
    description: '音频驱动的波形动画效果',
    demo: 'waves',
  },
  {
    id: 'morphing',
    title: '形态变换',
    category: 'Animation',
    description: 'SVG 路径变形动画效果',
    demo: 'morphing',
  },
];
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg-primary: #050505;
        --bg-secondary: #0b0b0d;
        --bg-card: rgba(255, 255, 255, 0.03);
        --bg-card-hover: rgba(255, 255, 255, 0.05);
        --border: rgba(255, 255, 255, 0.08);
        --border-hover: rgba(255, 255, 255, 0.15);

        --text-primary: #f5f5f5;
        --text-secondary: #d4d4d8;
        --text-muted: #a1a1aa;
        --text-subtle: #71717a;

        --accent-blue: #60a5fa;
        --accent-violet: #8b5cf6;
        --accent-cyan: #22d3ee;
        --gradient: linear-gradient(135deg, #60a5fa, #8b5cf6, #22d3ee);
        --gradient-text: linear-gradient(135deg, #60a5fa, #8b5cf6);

        --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
        --font-mono: 'JetBrains Mono', 'Space Mono', monospace;
        --font-display: 'Bebas Neue', sans-serif;

        --shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
        --shadow-hover: 0 8px 32px rgba(96, 165, 250, 0.15);

        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 16px;

        --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--bg-primary);
        color: var(--text-primary);
        line-height: 1.6;
        overflow-x: hidden;
      }

      @media (pointer: fine) {
        body {
          cursor: none;
        }
      }

      @media (pointer: coarse) {
        #cursor,
        #cursor-follower {
          display: none;
        }
      }

      #shader-canvas {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 0;
        opacity: 0.5;
        pointer-events: none;
      }

      #cursor {
        position: fixed;
        width: 8px;
        height: 8px;
        background: var(--accent-blue);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-50%, -50%);
        transition: width 0.2s, height 0.2s;
        mix-blend-mode: difference;
      }

      #cursor-follower {
        position: fixed;
        width: 40px;
        height: 40px;
        border: 1.5px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9998;
        transform: translate(-50%, -50%);
        transition: all 0.12s ease;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
        pointer-events: none;
        z-index: 1000;
      }

      #shader-canvas {
        position: fixed;
        inset: 0;
        z-index: 0;
        opacity: 0.4;
        background: #050505;
      }

      #particle-canvas {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        background: transparent;
      }

      #hero {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 8rem 2rem 4rem;
        position: relative;
        z-index: 10;
      }

      .hero-content {
        text-align: center;
        max-width: 800px;
      }

      .hero-badge {
        display: inline-block;
        padding: 0.5rem 1rem;
        background: rgba(96, 165, 250, 0.1);
        border: 1px solid rgba(96, 165, 250, 0.2);
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--accent-blue);
        margin-bottom: 1.5rem;
        opacity: 0;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      }

      .hero-title {
        font-size: clamp(3rem, 10vw, 5rem);
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1.5rem;
      }

      .hero-line {
        display: block;
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-violet), var(--accent-cyan));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        opacity: 0;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      }

      .hero-line:nth-child(1) {
        animation-delay: 0.2s;
      }

      .hero-line:nth-child(2) {
        animation-delay: 0.4s;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .hero-description {
        font-size: 1.25rem;
        color: var(--text-secondary);
        max-width: 600px;
        margin: 0 auto;
        opacity: 0;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: 0.6s;
      }

      #experiments {
        padding: 8rem 2rem;
        position: relative;
        z-index: 1;
        background: rgba(5, 5, 5, 0.8);
      }

      .section-header {
        text-align: center;
        margin-bottom: 4rem;
      }

      .section-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--accent-blue);
        margin-bottom: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .section-title {
        font-size: clamp(2rem, 6vw, 3.5rem);
        font-weight: 700;
        color: var(--text-primary);
      }

      .experiments-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        max-width: 1200px;
        margin: 0 auto;
      }

      .experiment-card {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition:
          transform 0.3s ease,
          border-color 0.3s ease;
        opacity: 0;
        transform: translateY(30px);
      }

      .experiment-card.visible {
        opacity: 1;
        transform: translateY(0);
        transition:
          opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
          transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
      }

      .experiment-card:hover {
        transform: translateY(-4px);
        border-color: rgba(96, 165, 250, 0.3);
      }

      .exp-canvas {
        width: 100%;
        height: 200px;
        background: linear-gradient(135deg, rgba(96, 165, 250, 0.1), rgba(139, 92, 246, 0.1));
      }

      .exp-overlay {
        padding: 1.5rem;
      }

      .exp-category {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background: rgba(96, 165, 250, 0.1);
        border-radius: 4px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.7rem;
        color: var(--accent-blue);
        margin-bottom: 0.75rem;
      }

      .exp-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
      }

      .exp-description {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin-bottom: 1rem;
        line-height: 1.6;
      }

      .exp-button {
        padding: 0.5rem 1.25rem;
        background: transparent;
        border: 1px solid rgba(96, 165, 250, 0.3);
        border-radius: 6px;
        color: var(--accent-blue);
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all var(--transition-fast);
      }

      .exp-button:hover {
        background: rgba(96, 165, 250, 0.1);
        border-color: var(--accent-blue);
      }

      .demo-controls {
        max-width: 800px;
        margin: 4rem auto 0;
        padding: 2rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        text-align: center;
      }

      .demo-controls h3 {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: var(--text-primary);
      }

      .demo-controls p {
        color: var(--text-secondary);
        margin-bottom: 1.5rem;
      }

      .demo-controls button {
        margin: 0.5rem;
        padding: 0.75rem 1.5rem;
        background: linear-gradient(135deg, var(--accent-blue), var(--accent-violet));
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition:
          transform var(--transition-fast),
          box-shadow var(--transition-fast);
      }

      .demo-controls button:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 20px rgba(96, 165, 250, 0.3);
      }

      footer {
        padding: 4rem 2rem;
        background: var(--bg-secondary);
        border-top: 1px solid var(--border);
        position: relative;
        z-index: 1;
      }

      .footer-content {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .footer-links {
        display: flex;
        gap: 2rem;
        list-style: none;
      }

      .footer-links a {
        color: var(--text-subtle);
        text-decoration: none;
        font-size: 0.875rem;
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--text-primary);
      }

      .footer-copyright {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      @media (max-width: 768px) {
        .hero-title {
          font-size: clamp(2rem, 10vw, 3.5rem);
        }
        .experiments-grid {
          grid-template-columns: 1fr;
        }
        .footer-content {
          flex-direction: column;
          gap: 1rem;
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <div id="cursor"></div>
    <div id="cursor-follower"></div>
    <canvas id="shader-canvas"></canvas>
    <canvas id="particle-canvas"></canvas>

    <Navbar activePage="lab" />

    <section id="hero">
      <div class="hero-content">
        <div class="hero-badge">LAB</div>
        <h1 class="hero-title">
          <span class="hero-line">动效</span>
          <span class="hero-line">实验室</span>
        </h1>
        <p class="hero-description">探索 WebGL、动画与交互的边界。这里是我实验和探索新技术的地方。</p>
      </div>
    </section>

    <section id="experiments">
      <div class="section-header">
        <span class="section-label">EXPERIMENTS</span>
        <h2 class="section-title">交互式演示</h2>
      </div>

      <div class="experiments-grid">
        {
          experiments.map((exp, index) => (
            <div class="experiment-card" style={{ animationDelay: `${index * 0.1}s` }} data-demo={exp.demo}>
              <canvas class="exp-canvas" id={`canvas-${exp.id}`} />
              <div class="exp-overlay">
                <span class="exp-category">{exp.category}</span>
                <h3 class="exp-title">{exp.title}</h3>
                <p class="exp-description">{exp.description}</p>
                <button class="exp-button">运行演示</button>
              </div>
            </div>
          ))
        }
      </div>

      <div class="demo-controls">
        <h3>实时演示</h3>
        <p>点击下方按钮查看动效演示</p>
        <button onclick="runParticleDemo()">粒子系统</button>
        <button onclick="runShaderDemo()">Shader 流体</button>
        <button onclick="runWaveDemo()">波形动画</button>
      </div>
    </section>

    <footer>
      <div class="footer-content">
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/articles">Blog</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/about">About</a></li>
        </ul>
        <div class="footer-copyright">2024 Conor Liu. All rights reserved.</div>
      </div>
    </footer>

    <script>
      const sc = document.getElementById('shader-canvas');
      const sgl = sc.getContext('webgl') || sc.getContext('experimental-webgl');

      function resizeCanvas(canvas) {
        canvas.width = innerWidth;
        canvas.height = innerHeight;
      }

      resizeCanvas(sc);
      window.addEventListener('resize', () => resizeCanvas(sc));

      if (sgl) {
        const gl = sgl;
        gl.clearColor(0.02, 0.02, 0.02, 1);
        gl.clear(gl.COLOR_BUFFER_BIT);

        const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
        const fs = `precision highp float;
          uniform float t;uniform vec2 r;uniform vec2 m;
          vec3 pal(float t,vec3 a,vec3 b,vec3 c,vec3 d){return a+b*cos(6.28318*(c*t+d));}
          float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
          float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
          float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
          void main(){
            vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
            vec2 mu=(m/r-.5)*2.;
            float time=t*.2;
            vec2 q=vec2(fbm(uv+vec2(0,0)),fbm(uv+vec2(5.2,1.3)));
            vec2 p2=uv+.5*q+vec2(1.7+sin(time*.5)*mu.x*.2,9.2+cos(time*.3)*mu.y*.2);
            float f=fbm(p2);
            vec3 col=pal(f+time*.05,vec3(.3,.3,.4),vec3(.2,.2,.3),vec3(.8,.8,1.),vec3(0,.1,.2));
            col=mix(col,vec3(.2,.1,.3),clamp(f*f*2.,0.,1.));
            col*=1.-length(uv)*.3;
            gl_FragColor=vec4(col*.25,1);
          }`;

        function mkShader(gl, type, src) {
          const s = gl.createShader(type);
          gl.shaderSource(s, src);
          gl.compileShader(s);
          return s;
        }

        const prog = gl.createProgram();
        gl.attachShader(prog, mkShader(gl, gl.VERTEX_SHADER, vs));
        gl.attachShader(prog, mkShader(gl, gl.FRAGMENT_SHADER, fs));
        gl.linkProgram(prog);
        gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

        const tl = gl.getUniformLocation(prog, 't');
        const rl = gl.getUniformLocation(prog, 'r');
        const ml = gl.getUniformLocation(prog, 'm');

        let mx = 0, my = 0;
        document.addEventListener('mousemove', (e) => {
          mx = e.clientX;
          my = e.clientY;
        });

        function animShader(ts) {
          gl.uniform1f(tl, ts * 0.001);
          gl.uniform2f(rl, sc.width, sc.height);
          gl.uniform2f(ml, mx, my);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          requestAnimationFrame(animShader);
        }
        requestAnimationFrame(animShader);
      }

      const pc = document.getElementById('particle-canvas');
      const pctx = pc.getContext('2d');
      resizeCanvas(pc);
      window.addEventListener('resize', () => resizeCanvas(pc));

      const particles = [];
      for (let i = 0; i < 50; i++) {
        particles.push({
          x: Math.random() * pc.width,
          y: Math.random() * pc.height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          size: Math.random() * 2 + 0.5,
          alpha: Math.random() * 0.5 + 0.1
        });
      }

      function animateParticles() {
        pctx.clearRect(0, 0, pc.width, pc.height);
        
        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < 0) p.x = pc.width;
          if (p.x > pc.width) p.x = 0;
          if (p.y < 0) p.y = pc.height;
          if (p.y > pc.height) p.y = 0;

          pctx.beginPath();
          pctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          pctx.fillStyle = `rgba(96, 165, 250, ${p.alpha})`;
          pctx.fill();
        });

        requestAnimationFrame(animateParticles);
      }
      animateParticles();

      const cur = document.getElementById('cursor');
      const fol = document.getElementById('cursor-follower');
      if (cur && fol) {
        let fx = 0, fy = 0, cx2 = 0, cy2 = 0;

        document.addEventListener('mousemove', (e) => {
          cx2 = e.clientX;
          cy2 = e.clientY;
          cur.style.left = cx2 + 'px';
          cur.style.top = cy2 + 'px';
        });

        function animCursor() {
          fx += (cx2 - fx) * 0.10;
          fy += (cy2 - fy) * 0.10;
          fol.style.left = fx + 'px';
          fol.style.top = fy + 'px';
          requestAnimationFrame(animCursor);
        }
        animCursor();

        document.querySelectorAll('a, button, input, textarea').forEach((el) => {
          el.addEventListener('mouseenter', () => {
            fol.style.transform = 'translate(-50%, -50%) scale(1.4)';
            fol.style.borderColor = 'var(--accent-violet)';
            cur.style.width = '10px';
            cur.style.height = '10px';
          });
          el.addEventListener('mouseleave', () => {
            fol.style.transform = 'translate(-50%, -50%) scale(1)';
            fol.style.borderColor = 'rgba(255, 255, 255, 0.15)';
            cur.style.width = '8px';
            cur.style.height = '8px';
          });
        });
      }

      function runParticleDemo() {
        const canvas = document.getElementById('canvas-particles');
        const ctx = canvas.getContext('2d');
        const particles = [];
        const particleCount = 80;

        for (let i = 0; i < particleCount; i++) {
          particles.push({
            x: Math.random() * canvas.width,
            y: Math.random() * canvas.height,
            vx: (Math.random() - 0.5) * 1.5,
            vy: (Math.random() - 0.5) * 1.5,
            size: Math.random() * 2 + 1,
            hue: Math.random() * 60 + 180
          });
        }

        function animate() {
          ctx.fillStyle = 'rgba(5, 5, 10, 0.15)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          particles.forEach((p) => {
            p.x += p.vx;
            p.y += p.vy;

            if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
            if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = `hsla(${p.hue}, 80%, 60%, 0.7)`;
            ctx.fill();
          });

          requestAnimationFrame(animate);
        }
        animate();
      }

      function runShaderDemo() {
        const canvas = document.getElementById('canvas-shader');
        const gl = canvas.getContext('webgl');

        if (!gl) return;

        const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
        const fs = `precision highp float;
          uniform float t;
          uniform vec2 r;
          float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
          float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
          float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
          void main(){
            vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
            float f=fbm(uv+t*.2);
            vec3 col=vec3(f*.8+.2,f*.6+.2,f*.4+.2);
            gl_FragColor=vec4(col,1);
          }`;

        const prog = gl.createProgram();
        const s = gl.createShader(gl.VERTEX_SHADER);
        gl.shaderSource(s, vs);
        gl.compileShader(s);
        gl.attachShader(prog, s);

        const fsShader = gl.createShader(gl.FRAGMENT_SHADER);
        gl.shaderSource(fsShader, fs);
        gl.compileShader(fsShader);
        gl.attachShader(prog, fsShader);

        gl.linkProgram(prog);
        gl.useProgram(prog);

        const buf = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, buf);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        const loc = gl.getAttribLocation(prog, 'p');
        gl.enableVertexAttribArray(loc);
        gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

        const tl = gl.getUniformLocation(prog, 't');
        const rl = gl.getUniformLocation(prog, 'r');

        function anim(ts) {
          gl.uniform1f(tl, ts * 0.001);
          gl.uniform2f(rl, canvas.width, canvas.height);
          gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
          requestAnimationFrame(anim);
        }
        anim(0);
      }

      function runWaveDemo() {
        const canvas = document.getElementById('canvas-waves');
        const ctx = canvas.getContext('2d');
        let time = 0;

        function animate() {
          ctx.fillStyle = 'rgba(5, 5, 10, 0.15)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          for (let wave = 0; wave < 3; wave++) {
            ctx.beginPath();
            ctx.moveTo(0, canvas.height / 2);
            const offset = wave * Math.PI * 0.6;
            const amplitude = 25 - wave * 5;

            for (let x = 0; x < canvas.width; x++) {
              const y = canvas.height / 2 + 
                Math.sin(x * 0.02 + time + offset) * amplitude + 
                Math.sin(x * 0.01 + time * 0.5 + offset) * (amplitude * 0.5);
              ctx.lineTo(x, y);
            }

            ctx.strokeStyle = `rgba(${100 + wave * 30}, ${165 + wave * 20}, ${250 - wave * 30}, 0.6)`;
            ctx.lineWidth = 2 - wave * 0.3;
            ctx.stroke();
          }

          time += 0.04;
          requestAnimationFrame(animate);
        }
        animate();
      }

      function runMorphingDemo() {
        const canvas = document.getElementById('canvas-morphing');
        const ctx = canvas.getContext('2d');
        let time = 0;

        const shapes = [
          (t) => ({ x: Math.cos(t) * 50, y: Math.sin(t) * 50 }),
          (t) => ({ x: Math.cos(t) * 40, y: Math.sin(t * 2) * 60 }),
          (t) => ({ x: Math.cos(t * 1.5) * 60, y: Math.sin(t) * 40 }),
          (t) => ({ x: Math.cos(t) * 30, y: Math.sin(t * 3) * 30 })
        ];

        function animate() {
          ctx.fillStyle = 'rgba(5, 5, 10, 0.15)';
          ctx.fillRect(0, 0, canvas.width, canvas.height);

          const centerX = canvas.width / 2;
          const centerY = canvas.height / 2;
          const shapeIndex = Math.floor(time * 0.5) % shapes.length;
          const nextShapeIndex = (shapeIndex + 1) % shapes.length;
          const morphFactor = (time * 0.5) % 1;

          ctx.beginPath();
          for (let i = 0; i <= 100; i++) {
            const t = (i / 100) * Math.PI * 2;
            const s1 = shapes[shapeIndex](t);
            const s2 = shapes[nextShapeIndex](t);
            
            const x = centerX + (s1.x * (1 - morphFactor) + s2.x * morphFactor);
            const y = centerY + (s1.y * (1 - morphFactor) + s2.y * morphFactor);

            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          ctx.closePath();

          const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, 60);
          gradient.addColorStop(0, 'rgba(139, 92, 246, 0.4)');
          gradient.addColorStop(1, 'rgba(96, 165, 250, 0.2)');
          ctx.fillStyle = gradient;
          ctx.fill();

          ctx.strokeStyle = 'rgba(139, 92, 246, 0.6)';
          ctx.lineWidth = 2;
          ctx.stroke();

          time += 0.02;
          requestAnimationFrame(animate);
        }
        animate();
      }

      document.querySelectorAll('.exp-button').forEach((btn, index) => {
        btn.addEventListener('click', () => {
          const demos = [runParticleDemo, runShaderDemo, runWaveDemo, runMorphingDemo];
          if (demos[index]) demos[index]();
        });
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry, index) => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                entry.target.classList.add('visible');
              }, index * 100);
              io.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
      );

      document.querySelectorAll('.experiment-card').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
