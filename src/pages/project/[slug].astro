---
// @ts-check
export const prerender = true;

import Navbar from '../../components/Navbar.astro';

export function getStaticPaths() {
  const projects = {
    'ai-gateway-lite': {
      title: 'ai-gateway-lite',
      subtitle: '轻量 AI 网关，多模型路由 + 降级 + 预算控制',
      tags: ['TypeScript', 'AI', 'API', 'Gateway'],
      techStack: ['TypeScript', 'Node.js', 'Express', 'OpenAI API', 'Anthropic API'],
      description: '路由、降级、限流、成本控制——调多个 LLM 必须解决的四个问题，一个零依赖 TypeScript 库搞定。',
      features: [
        '多模型路由：支持多个 AI 模型提供商，智能路由请求',
        '自动降级：在服务不可用时自动切换到备用服务',
        '限流控制：防止 API 调用过载，保护服务稳定性',
        '成本控制：精确控制 API 调用成本，避免意外超支',
      ],
      stats: {
        downloads: '50K+',
        stars: '1.2K',
        watchers: '86',
        forks: '124',
      },
      githubUrl: 'https://github.com/conorliu/ai-gateway-lite',
    },
    'ai-memory': {
      title: 'ai-memory',
      subtitle: '把 Cursor 对话变成结构化知识库',
      tags: ['TypeScript', 'AI', 'Knowledge', 'Productivity'],
      techStack: ['TypeScript', 'Node.js', 'Git', 'Cursor API'],
      description: '零 .remember() 埋点，直接读 AI 编辑器聊天记录，提取决策/架构/约定，输出结构化文档。',
      features: [
        '自动提取：无需手动标记，自动提取关键信息',
        '结构化输出：支持 Markdown、JSON、YAML 等格式',
        'Git 可追踪：所有变更通过 Git 管理',
        '多编辑器支持：兼容 Cursor、VS Code Copilot 等',
      ],
      stats: {
        downloads: '25K+',
        stars: '890',
        watchers: '52',
        forks: '78',
      },
      githubUrl: 'https://github.com/conorliu/ai-memory',
    },
    'shader-playground': {
      title: 'Shader Playground',
      subtitle: 'WebGL Shader 实时编辑器与效果预览',
      tags: ['WebGL', 'GLSL', 'Visualization', 'Editor'],
      techStack: ['TypeScript', 'React', 'WebGL', 'GLSL', 'Monaco Editor'],
      description: '在线 Shader 编辑器，支持实时预览、代码高亮、效果分享。',
      features: [
        '实时预览：WebGL 实时渲染',
        '语法高亮：GLSL 代码支持',
        '效果分享：一键分享你的 Shader',
        '预设模板：丰富的示例和模板',
      ],
      stats: {
        visits: '100K+',
        stars: '650',
        watchers: '41',
        forks: '92',
      },
      githubUrl: 'https://github.com/conorliu/shader-playground',
    },
    'particle-system': {
      title: 'Particle System',
      subtitle: '高性能粒子系统，支持百万级粒子渲染',
      tags: ['WebGL', 'Animation', 'Performance', 'Particles'],
      techStack: ['TypeScript', 'WebGL', 'GLSL', 'SIMD'],
      description: '基于 WebGL 的高性能粒子系统，支持粒子碰撞、物理模拟、GPU 加速。',
      features: [
        'GPU 加速：利用 WebGL 并行计算能力',
        '百万级粒子：流畅渲染大规模粒子',
        '物理模拟：支持重力、碰撞、风力等',
        '模块化设计：易于扩展和定制',
      ],
      stats: {
        downloads: '15K+',
        stars: '420',
        watchers: '28',
        forks: '56',
      },
      githubUrl: 'https://github.com/conorliu/particle-system',
    },
    'realtime-charts': {
      title: 'Realtime Charts',
      subtitle: '实时数据可视化图表库',
      tags: ['React', 'Visualization', 'Data', 'Charts'],
      techStack: ['TypeScript', 'React', 'D3.js', 'Canvas API'],
      description: '专注于实时数据可视化的图表库，支持毫秒级数据更新。',
      features: [
        '实时更新：毫秒级数据刷新',
        '多种图表：折线图、柱状图、饼图等',
        '交互丰富：缩放、平移、悬停提示',
        '响应式设计：适配各种屏幕尺寸',
      ],
      stats: {
        downloads: '35K+',
        stars: '780',
        watchers: '39',
        forks: '87',
      },
      githubUrl: 'https://github.com/conorliu/realtime-charts',
    },
    'micro-frontends': {
      title: 'Micro Frontends',
      subtitle: '微前端架构实践与组件库',
      tags: ['React', 'Architecture', 'Monorepo', 'Micro Frontends'],
      techStack: ['TypeScript', 'React', 'Module Federation', 'TurboRepo'],
      description: '企业级微前端解决方案，包含组件库、脚手架和最佳实践。',
      features: [
        'Module Federation：运行时模块共享',
        'Monorepo 架构：统一管理多个应用',
        '组件库：可复用的 UI 组件',
        '最佳实践：完整的架构文档',
      ],
      stats: {
        downloads: '45K+',
        stars: '920',
        watchers: '67',
        forks: '112',
      },
      githubUrl: 'https://github.com/conorliu/micro-frontends',
    },
  };

  return Object.keys(projects).map((projectSlug) => ({
    params: { slug: projectSlug },
    props: { project: projects[projectSlug] },
  }));
}

const project = Astro.props.project;
const { title, subtitle, tags, techStack, description, features, stats, githubUrl } = project;
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={subtitle} />
    <title>{title} - Conor Liu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Bebas+Neue&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="cursor"></div>
    <div id="cursor-follower"></div>

    <canvas id="shader-canvas"></canvas>

    <Navbar activePage="projects" />

    <article class="project-container">
      <header class="project-header reveal">
        <a href="/projects" class="back-link">← 返回项目列表</a>
        <div class="project-tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
        <h1 class="project-title">{title}</h1>
        <p class="project-subtitle">{subtitle}</p>
      </header>

      <section class="project-hero reveal">
        <div class="hero-canvas-wrapper">
          <canvas id="hero-canvas"></canvas>
          <div class="hero-gradient"></div>
        </div>
      </section>

      <section class="project-content">
        <div class="content-row reveal">
          <div class="content-main">
            <h2 class="section-title">项目简介</h2>
            <p class="section-text">{description}</p>
          </div>
          <div class="content-sidebar">
            <div class="stats-card">
              <h3 class="stats-title">项目统计</h3>
              <div class="stats-grid">
                <div class="stat-item">
                  <span class="stat-value">{stats.downloads}</span>
                  <span class="stat-label">Downloads</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value">{stats.stars}</span>
                  <span class="stat-label">Stars</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value">{stats.watchers}</span>
                  <span class="stat-label">Watchers</span>
                </div>
                <div class="stat-item">
                  <span class="stat-value">{stats.forks}</span>
                  <span class="stat-label">Forks</span>
                </div>
              </div>
              <a href={githubUrl} target="_blank" class="github-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path
                    d="M15 22v-4a4.86 4.86 0 0 0-1-3.75 4.38 4.38 0 0 0-.11-1.34L15 3.79a2.43 2.43 0 0 0-2.5-2.26 2.47 2.47 0 0 0-1.86.81L7 8.73a4.38 4.38 0 0 0-.11 1.34A4.86 4.86 0 0 0 6 18v4"
                  ></path>
                  <path d="M9 18.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"></path>
                  <path d="M15 18.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"></path>
                </svg>
                <span>View on GitHub</span>
              </a>
            </div>
          </div>
        </div>

        <div class="content-row reveal">
          <div class="tech-stack">
            <h2 class="section-title">技术栈</h2>
            <div class="tech-tags">
              {techStack.map((tech) => <span class="tech-tag">{tech}</span>)}
            </div>
          </div>
        </div>

        <div class="content-row reveal">
          <div class="features-section">
            <h2 class="section-title">核心功能</h2>
            <div class="features-list">
              {
                features.map((feature, index) => (
                  <div class="feature-item">
                    <span class="feature-number">{String(index + 1).padStart(2, '0')}</span>
                    <p class="feature-text">{feature}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <footer class="project-footer">
        <div class="footer-nav">
          <a href="/projects" class="btn btn-outline">← 返回项目列表</a>
        </div>
      </footer>
    </article>

    <footer class="site-footer">
      <div class="footer-content">
        <span class="footer-text">© 2026 Hanshan. Built with code & coffee.</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/articles">Blog</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg-primary: #050505;
    --bg-secondary: #0b0b0d;
    --bg-card: rgba(255, 255, 255, 0.03);
    --border: rgba(255, 255, 255, 0.08);
    --border-hover: rgba(255, 255, 255, 0.15);

    --text-primary: #f5f5f5;
    --text-secondary: #d4d4d8;
    --text-muted: #a1a1aa;
    --text-subtle: #71717a;

    --accent-blue: #60a5fa;
    --accent-violet: #8b5cf6;
    --accent-cyan: #22d3ee;
    --gradient: linear-gradient(135deg, #60a5fa, #8b5cf6, #22d3ee);
    --gradient-text: linear-gradient(135deg, #60a5fa, #8b5cf6);

    --font-sans: 'Inter', system-ui, -apple-system, sans-serif;
    --font-mono: 'JetBrains Mono', 'Space Mono', monospace;
    --font-display: 'Bebas Neue', sans-serif;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-normal: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  html {
    scroll-behavior: smooth;
  }

  @media (pointer: fine) {
    body {
      cursor: none;
    }
  }

  @media (pointer: coarse) {
    #cursor,
    #cursor-follower {
      display: none;
    }
  }

  body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-sans);
    line-height: 1.75;
    overflow-x: hidden;
    min-height: 100vh;
  }

  /* CURSOR */
  #cursor {
    position: fixed;
    width: 8px;
    height: 8px;
    background: var(--accent-blue);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: width 0.2s, height 0.2s;
    mix-blend-mode: difference;
  }

  #cursor-follower {
    position: fixed;
    width: 40px;
    height: 40px;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: all 0.12s ease;
  }

  /* NOISE OVERLAY */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1000;
  }

  /* SHADER CANVAS */
  #shader-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
    opacity: 0.2;
  }

  /* PROJECT CONTAINER */
  .project-container {
    position: relative;
    z-index: 10;
    padding-top: 6rem;
  }

  .project-header {
    padding: 2rem 2rem 1rem;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-blue);
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--accent-cyan);
  }

  .project-tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.35rem 0.8rem;
    background: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.15);
    border-radius: 999px;
    color: var(--text-muted);
  }

  .project-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .project-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  /* PROJECT HERO */
  .project-hero {
    padding: 2rem;
    margin-bottom: 2rem;
  }

  .hero-canvas-wrapper {
    max-width: 1000px;
    margin: 0 auto;
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    aspect-ratio: 16 / 9;
  }

  #hero-canvas {
    width: 100%;
    height: 100%;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(5, 5, 5, 0) 0%, rgba(5, 5, 5, 0.8) 100%);
    pointer-events: none;
  }

  /* PROJECT CONTENT */
  .project-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .content-row {
    margin-bottom: 4rem;
  }

  .content-main {
    flex: 1;
  }

  .content-sidebar {
    width: 320px;
    flex-shrink: 0;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    position: relative;
    padding-left: 1.5rem;
  }

  .section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent-blue);
    border-radius: 50%;
  }

  .section-text {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  /* STATS CARD */
  .stats-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .stats-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-subtle);
    letter-spacing: 0.05em;
  }

  .github-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.85rem 1.5rem;
    background: rgba(96, 165, 250, 0.08);
    border: 1px solid rgba(96, 165, 250, 0.2);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-blue);
    text-decoration: none;
    transition: all var(--transition-normal);
  }

  .github-btn:hover {
    background: rgba(96, 165, 250, 0.15);
    border-color: var(--accent-blue);
  }

  /* TECH STACK */
  .tech-stack {
    margin-bottom: 2rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tech-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .tech-tag:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
  }

  /* FEATURES */
  .features-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .feature-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition-fast);
  }

  .feature-item:hover {
    border-color: var(--accent-blue);
  }

  .feature-number {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-blue);
    min-width: 2rem;
    text-align: right;
  }

  .feature-text {
    color: var(--text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  /* PROJECT FOOTER */
  .project-footer {
    padding: 2rem;
    margin-top: 4rem;
    border-top: 1px solid var(--border);
  }

  .footer-nav {
    display: flex;
    justify-content: center;
  }

  .btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.9rem 2rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-normal);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn-outline {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--border);
  }

  .btn-outline:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    background: rgba(96, 165, 250, 0.05);
  }

  /* SITE FOOTER */
  .site-footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: 2.5rem 2rem;
    position: relative;
    z-index: 10;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-text {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-subtle);
    letter-spacing: 0.05em;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-links a {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-subtle);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  /* REVEAL ANIMATION */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
  }

  @media (max-width: 1024px) {
    .content-row {
      flex-direction: column;
      gap: 2rem;
    }
    .content-sidebar {
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .project-container {
      padding-top: 4rem;
    }
    .project-header {
      padding: 1rem;
    }
    .project-title {
      font-size: clamp(1.75rem, 5vw, 2.75rem);
    }
    .section-title::before {
      display: none;
    }
    .section-title {
      padding-left: 0;
    }
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
    .stat-value {
      font-size: 1.1rem;
    }
    .footer-content {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
  }
</style>

<script>
  // ─── SHADER BACKGROUND ───────────────────────────────────────────
  const sc = document.getElementById('shader-canvas');
  const sgl = sc.getContext('webgl') || sc.getContext('experimental-webgl');

  function resizeShader() {
    sc.width = innerWidth;
    sc.height = innerHeight;
    if (sgl) sgl.viewport(0, 0, sc.width, sc.height);
  }
  resizeShader();
  window.addEventListener('resize', resizeShader);

  if (sgl) {
    const gl = sgl;
    const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
    const fs = `precision highp float;
uniform float t;uniform vec2 r;uniform vec2 m;
vec3 pal(float t,vec3 a,vec3 b,vec3 c,vec3 d){return a+b*cos(6.28318*(c*t+d));}
float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
void main(){
  vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
  vec2 mu=(m/r-.5)*2.;
  float time=t*.2;
  vec2 q=vec2(fbm(uv+vec2(0,0)),fbm(uv+vec2(5.2,1.3)));
  vec2 p2=uv+.5*q+vec2(1.7+sin(time*.5)*mu.x*.2,9.2+cos(time*.3)*mu.y*.2);
  float f=fbm(p2);
  vec3 col=pal(f+time*.05,vec3(.3,.3,.4),vec3(.2,.2,.3),vec3(.8,.8,1.),vec3(0,.1,.2));
  col=mix(col,vec3(.2,.1,.3),clamp(f*f*2.,0.,1.));
  col*=1.-length(uv)*.3;
  gl_FragColor=vec4(col*.25,1);
}`;

    function mkShader(gl, type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }

    const prog = gl.createProgram();
    gl.attachShader(prog, mkShader(gl, gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, mkShader(gl, gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const tl = gl.getUniformLocation(prog, 't');
    const rl = gl.getUniformLocation(prog, 'r');
    const ml = gl.getUniformLocation(prog, 'm');

    let mx = 0,
      my = 0;
    document.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    });

    function animShader(ts) {
      gl.uniform1f(tl, ts * 0.001);
      gl.uniform2f(rl, sc.width, sc.height);
      gl.uniform2f(ml, mx, my);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      requestAnimationFrame(animShader);
    }
    requestAnimationFrame(animShader);
  }

  // ─── HERO CANVAS ───────────────────────────────────────────
  const heroCanvas = document.getElementById('hero-canvas');
  const heroGl = heroCanvas.getContext('webgl') || heroCanvas.getContext('experimental-webgl');

  function resizeHero() {
    heroCanvas.width = heroCanvas.offsetWidth;
    heroCanvas.height = heroCanvas.offsetHeight;
    if (heroGl) heroGl.viewport(0, 0, heroCanvas.width, heroCanvas.height);
  }
  resizeHero();
  window.addEventListener('resize', resizeHero);

  if (heroGl) {
    const gl = heroGl;
    const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
    const fs = `precision highp float;
uniform float t;uniform vec2 r;
float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<6;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
void main(){
  vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
  float time=t*.3;
  
  float f=fbm(uv+vec2(time*.2,0));
  float g=fbm(uv+vec2(time*.1,-time*.15));
  
  vec3 col=vec3(.1,.1,.15);
  col=mix(col,vec3(.2,.25,.35),f);
  col=mix(col,vec3(.15,.2,.3),g);
  
  float ring=smoothstep(.5,.8,length(uv));
  col=mix(col,vec3(.05,.05,.08),ring);
  
  float edge=smoothstep(.9,1.,length(uv));
  col=mix(col,vec3(0),edge);
  
  gl_FragColor=vec4(col,1);
}`;

    function mkShader(gl, type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }

    const prog = gl.createProgram();
    gl.attachShader(prog, mkShader(gl, gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, mkShader(gl, gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const tl = gl.getUniformLocation(prog, 't');
    const rl = gl.getUniformLocation(prog, 'r');

    function anim(ts) {
      gl.uniform1f(tl, ts * 0.001);
      gl.uniform2f(rl, heroCanvas.width, heroCanvas.height);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      requestAnimationFrame(anim);
    }
    requestAnimationFrame(anim);
  }

  // ─── CURSOR ANIMATION ───────────────────────────────────────────
  const cur = document.getElementById('cursor');
  const fol = document.getElementById('cursor-follower');
  if (cur && fol) {
    let fx = 0,
      fy = 0,
      cx2 = 0,
      cy2 = 0;

    document.addEventListener('mousemove', (e) => {
      cx2 = e.clientX;
      cy2 = e.clientY;
      cur.style.left = cx2 + 'px';
      cur.style.top = cy2 + 'px';
    });

    function animCursor() {
      fx += (cx2 - fx) * 0.10;
      fy += (cy2 - fy) * 0.10;
      fol.style.left = fx + 'px';
      fol.style.top = fy + 'px';
      requestAnimationFrame(animCursor);
    }
    animCursor();

    document.querySelectorAll('a, button, input, textarea').forEach((el) => {
      el.addEventListener('mouseenter', () => {
        fol.style.transform = 'translate(-50%, -50%) scale(1.4)';
        fol.style.borderColor = 'var(--accent-violet)';
        cur.style.width = '10px';
        cur.style.height = '10px';
      });
      el.addEventListener('mouseleave', () => {
        fol.style.transform = 'translate(-50%, -50%) scale(1)';
        fol.style.borderColor = 'rgba(255, 255, 255, 0.15)';
        cur.style.width = '8px';
        cur.style.height = '8px';
      });
    });
  }

  // ─── SCROLL REVEAL ───────────────────────────────────────────
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          setTimeout(() => {
            e.target.style.transition =
              'opacity 0.7s cubic-bezier(0.4, 0, 0.2, 1), transform 0.7s cubic-bezier(0.4, 0, 0.2, 1)';
            e.target.style.opacity = '1';
            e.target.style.transform = 'translateY(0)';
          }, i * 80);
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -30px 0px' },
  );

  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
