---
import Navbar from '../components/Navbar.astro';

const title = '留言板 - Hanshan';
const description = '留下你的想法和建议';
---

<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Space+Grotesk:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --bg-primary: #050508;
        --bg-secondary: #0a0a10;
        --bg-card: rgba(255, 255, 255, 0.02);
        --bg-card-hover: rgba(255, 255, 255, 0.04);
        
        --border: rgba(255, 255, 255, 0.05);
        --border-hover: rgba(139, 92, 246, 0.4);
        --border-focus: rgba(139, 92, 246, 0.6);
        
        --text-primary: #fafafa;
        --text-secondary: #a1a1aa;
        --text-muted: #71717a;
        --text-subtle: #52525b;
        
        --accent-blue: #3b82f6;
        --accent-violet: #8b5cf6;
        --accent-cyan: #06b6d4;
        --accent-purple: #a855f7;
        --accent-pink: #ec4899;
        --accent-amber: #f59e0b;
        
        --gradient: linear-gradient(135deg, #8b5cf6, #ec4899, #3b82f6);
        --gradient-text: linear-gradient(135deg, #8b5cf6, #ec4899);
        --gradient-cyan: linear-gradient(135deg, #06b6d4, #8b5cf6);
        --gradient-amber: linear-gradient(135deg, #f59e0b, #ec4899);
        
        --font-display: 'Space Grotesk', system-ui, sans-serif;
        --font-sans: 'Outfit', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        
        --shadow: 0 4px 30px rgba(0, 0, 0, 0.4);
        --shadow-glow: 0 0 60px rgba(139, 92, 246, 0.2);
        --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.5);
        
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 20px;
        --radius-xl: 28px;
        
        --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-normal: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        --transition-slow: 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        
        --icon-xs: 12px;
        --icon-sm: 14px;
        --icon-md: 18px;
        --icon-lg: 22px;
      }

      html {
        scroll-behavior: smooth;
        scrollbar-gutter: stable;
      }

      body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: var(--font-sans);
        line-height: 1.6;
        min-height: 100vh;
        overflow-x: hidden;
      }

      @media (pointer: fine) {
        body {
          cursor: none;
        }
      }

      @media (pointer: coarse) {
        #cursor,
        #cursor-follower {
          display: none;
        }
      }

      /* CURSOR */
      #cursor {
        position: fixed;
        width: 8px;
        height: 8px;
        background: var(--accent-blue);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9999;
        transform: translate(-50%, -50%);
        transition: width 0.2s, height 0.2s;
        mix-blend-mode: difference;
      }

      #cursor-follower {
        position: fixed;
        width: 40px;
        height: 40px;
        border: 1.5px solid rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        pointer-events: none;
        z-index: 9998;
        transform: translate(-50%, -50%);
        transition: all 0.12s ease;
      }

      /* GRID BACKGROUND */
      #grid-bg {
        position: fixed;
        inset: 0;
        background-image: 
          linear-gradient(rgba(96, 165, 250, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(96, 165, 250, 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        z-index: 0;
        pointer-events: none;
      }

      /* GRADIENT ORBS */
      #gradient-orbs {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        overflow: hidden;
      }

      .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        opacity: 0.35;
        animation: orbFloat 25s ease-in-out infinite;
      }

      .orb-1 {
        width: 600px;
        height: 600px;
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.4), rgba(236, 72, 153, 0.25));
        top: -250px;
        left: -150px;
        animation-delay: 0s;
      }

      .orb-2 {
        width: 500px;
        height: 500px;
        background: linear-gradient(135deg, rgba(236, 72, 153, 0.3), rgba(59, 130, 246, 0.2));
        top: 40%;
        right: -200px;
        animation-delay: -8s;
      }

      .orb-3 {
        width: 450px;
        height: 450px;
        background: linear-gradient(135deg, rgba(6, 182, 212, 0.25), rgba(139, 92, 246, 0.2));
        bottom: -150px;
        left: 30%;
        animation-delay: -16s;
      }

      @keyframes orbFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        25% { transform: translate(40px, -30px) scale(1.08); }
        50% { transform: translate(-30px, 40px) scale(0.95); }
        75% { transform: translate(25px, 25px) scale(1.03); }
      }

      /* NOISE TEXTURE OVERLAY */
      #noise-overlay {
        position: fixed;
        inset: 0;
        z-index: 1;
        pointer-events: none;
        opacity: 0.03;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      }

      /* MAIN CONTENT WRAPPER */
      #content-wrapper {
        position: relative;
        z-index: 20;
        min-height: 100vh;
      }

      /* HERO SECTION */
      #hero {
        min-height: 55vh;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 8rem 2rem 2rem;
        text-align: center;
        position: relative;
      }

      .hero-content {
        max-width: 800px;
        opacity: 0;
        animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      }

      .hero-badge {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent-cyan);
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-bottom: 1.5rem;
        display: inline-block;
        padding: 0.5rem 1.25rem;
        background: rgba(34, 211, 238, 0.08);
        border: 1px solid rgba(34, 211, 238, 0.15);
        border-radius: 999px;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: 0.1s;
        opacity: 0;
      }

      .hero-title {
        font-size: clamp(3rem, 10vw, 5rem);
        font-weight: 800;
        line-height: 1.1;
        margin-bottom: 1.5rem;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: 0.25s;
        opacity: 0;
      }

      .hero-title span {
        display: block;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .hero-description {
        font-size: 1.125rem;
        color: var(--text-secondary);
        line-height: 1.8;
        max-width: 600px;
        margin: 0 auto;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: 0.55s;
        opacity: 0;
      }

      .hero-stats {
        display: flex;
        gap: 3rem;
        justify-content: center;
        margin-top: 2.5rem;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: 0.7s;
        opacity: 0;
      }

      .stat-item {
        text-align: center;
      }

      .stat-value {
        font-size: 2.25rem;
        font-weight: 700;
        background: var(--gradient-text);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .stat-label {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        margin-top: 0.25rem;
      }

      @keyframes fadeInUp {
        from {
          opacity: 0;
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* MAIN SECTION */
      #guestbook {
        padding: 2rem 2rem 8rem;
        max-width: 1300px;
        margin: 0 auto;
      }

      .main-grid {
        display: grid;
        grid-template-columns: 1fr 1.3fr;
        gap: 4rem;
        align-items: start;
      }

      /* LEFT PANEL */
      .left-panel {
        position: sticky;
        top: 6rem;
        height: fit-content;
      }

      .panel-title {
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .panel-title::before {
        content: '';
        width: 4px;
        height: 24px;
        background: var(--gradient);
        border-radius: 2px;
      }

      .panel-description {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.7;
        margin-bottom: 2rem;
      }

      .atmosphere-text {
        font-style: italic;
        color: var(--text-muted);
        font-size: 0.9rem;
        border-left: 2px solid rgba(96, 165, 250, 0.3);
        padding-left: 1rem;
        margin-bottom: 2rem;
        line-height: 1.6;
      }

      .online-indicator {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.875rem 1.25rem;
        background: rgba(34, 211, 238, 0.05);
        border: 1px solid rgba(34, 211, 238, 0.12);
        border-radius: var(--radius-md);
        margin-bottom: 2rem;
      }

      .online-dot {
        width: 8px;
        height: 8px;
        background: #22d3ee;
        border-radius: 50%;
        box-shadow: 0 0 8px #22d3ee;
      }

      .online-text {
        font-size: 0.875rem;
        color: var(--text-secondary);
      }

      .social-links {
        display: flex;
        gap: 1rem;
      }

      .social-link {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text-muted);
        text-decoration: none;
        transition: all var(--transition-normal);
        font-size: 0.85rem;
        font-family: var(--font-mono);
      }

      .social-link:hover {
        background: rgba(96, 165, 250, 0.08);
        border-color: var(--border-hover);
        color: var(--accent-blue);
        transform: translateY(-2px);
      }

      /* RIGHT PANEL - FORM */
      .right-panel {
        display: flex;
        flex-direction: column;
        gap: 3rem;
      }

      /* GLASS FORM */
      .guestbook-form {
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: 0.2s;
        opacity: 0;
      }

      .guestbook-form::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: var(--gradient);
        opacity: 0;
        transition: opacity var(--transition-normal);
      }

      .guestbook-form:focus-within::before {
        opacity: 1;
      }

      .form-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .form-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, rgba(96, 165, 250, 0.12), rgba(139, 92, 246, 0.12));
        border-radius: var(--radius-md);
        font-size: 1.15rem;
      }

      .form-title {
        font-size: 1.25rem;
        font-weight: 600;
      }

      .form-subtitle {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-top: 0.15rem;
      }

      .form-group {
        margin-bottom: 1.5rem;
      }

      .form-label {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-secondary);
        margin-bottom: 0.5rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      .form-label .required {
        color: var(--accent-cyan);
      }

      .form-input,
      .form-textarea {
        width: 100%;
        padding: 0.875rem 1.25rem;
        background: rgba(255, 255, 255, 0.015);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        color: var(--text-primary);
        font-family: var(--font-sans);
        font-size: 0.95rem;
        transition: all var(--transition-normal);
        outline: none;
      }

      .form-input::placeholder,
      .form-textarea::placeholder {
        color: var(--text-subtle);
      }

      .form-input:focus,
      .form-textarea:focus {
        border-color: rgba(139, 92, 246, 0.35);
        background: rgba(255, 255, 255, 0.03);
        box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.06);
      }

      .form-textarea {
        resize: none;
        min-height: 140px;
        line-height: 1.6;
      }

      .char-counter {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.5rem;
      }

      .char-count {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--text-muted);
        padding: 0.15rem 0.4rem;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 4px;
      }

      .char-count.limit {
        color: #f97316;
      }

      /* SUBMIT BUTTON */
      .submit-btn {
        width: 100%;
        padding: 0.875rem 2rem;
        background: var(--gradient);
        color: white;
        border: none;
        border-radius: var(--radius-md);
        font-family: var(--font-mono);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all var(--transition-normal);
      }

      .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-glow);
      }

      .submit-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        transform: none;
      }

      .btn-content {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
      }

      .btn-loading {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,.3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: spin .8s linear infinite;
      }

      @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }

      .form-message {
        margin-top: 1rem;
        padding: 0.75rem 1rem;
        border-radius: var(--radius-sm);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        opacity: 0;
        transform: translateY(-8px);
        transition: all var(--transition-normal);
        height: 0;
        overflow: hidden;
      }

      .form-message.visible {
        opacity: 1;
        transform: translateY(0);
        height: auto;
      }

      .form-message.success {
        background: rgba(34, 197, 94, 0.08);
        border: 1px solid rgba(34, 197, 94, 0.15);
        color: #22c55e;
      }

      .form-message.error {
        background: rgba(239, 68, 68, 0.08);
        border: 1px solid rgba(239, 68, 68, 0.15);
        color: #ef4444;
      }

      /* MESSAGES SECTION */
      .messages-section {
        opacity: 0;
        transform: translateY(24px);
        animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        animation-delay: 0.35s;
      }

      .messages-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
      }

      .messages-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .messages-title::before {
        content: '';
        width: 4px;
        height: 24px;
        background: var(--gradient);
        border-radius: 2px;
      }

      .messages-count {
        background: var(--gradient);
        color: white;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        font-family: var(--font-mono);
      }

      .refresh-btn {
        padding: 0.6rem 1.25rem;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        cursor: pointer;
        transition: all var(--transition-normal);
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .refresh-btn:hover {
        border-color: rgba(139, 92, 246, 0.3);
        color: white;
        background: rgba(139, 92, 246, 0.05);
      }

      .refresh-btn.spinning .refresh-icon {
        animation: spin 1s linear infinite;
      }

      .refresh-icon {
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* === 升级版：大众美学·极简精致留言列表 === */
      .messages-list {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }

      .message-card {
        position: relative;
        background: rgba(255, 255, 255, 0.015);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.04);
        border-radius: var(--radius-lg);
        padding: 1.75rem;
        transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        gap: 1.25rem;
        overflow: hidden;
      }

      /* 顶部拟物微弱高光线 */
      .message-card::before {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: var(--radius-lg);
        padding: 1px;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0.08), transparent 40%);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
      }

      .message-card:hover {
        transform: translateY(-4px);
        background: rgba(255, 255, 255, 0.03);
        border-color: rgba(139, 92, 246, 0.2);
        box-shadow: 
          0 20px 40px rgba(0, 0, 0, 0.3),
          0 0 30px rgba(139, 92, 246, 0.04);
      }

      .message-avatar-zone {
        position: relative;
        flex-shrink: 0;
        width: 46px;
        height: 46px;
      }

      /* 纯圆头像 */
      .message-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        min-height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--font-display);
        font-size: 0.95rem;
        font-weight: 700;
        color: #fff;
        position: relative;
        z-index: 2;
        box-shadow: inset 0 1px 1px rgba(255,255,255,0.2);
        flex-shrink: 0;
      }

      /* 头像背后温润的弥散阴影 */
      .avatar-glow {
        position: absolute;
        inset: 0;
        filter: blur(10px);
        opacity: 0.35;
        z-index: 1;
        transition: transform 0.4s ease, opacity 0.4s ease;
      }

      .message-card:hover .avatar-glow {
        transform: scale(1.25);
        opacity: 0.5;
      }

      .message-detail {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }

      .message-meta-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.625rem;
        gap: 1rem;
      }

      .message-user-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
      }

      .message-nickname {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text-primary);
        letter-spacing: -0.01em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .message-via {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--accent-cyan);
        opacity: 0.85;
        background: rgba(6, 182, 212, 0.05);
        padding: 0.15rem 0.45rem;
        border-radius: 5px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 160px;
      }

      .message-badge-zone {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        flex-shrink: 0;
      }

      .message-floor {
        color: var(--text-subtle);
        font-weight: 500;
      }

      .message-split {
        color: rgba(255, 255, 255, 0.08);
      }

      .message-body {
        font-size: 0.95rem;
        color: rgba(250, 250, 250, 0.85);
        line-height: 1.7;
        word-break: break-word;
        white-space: pre-wrap;
        max-height: 200px;
        overflow-y: auto;
        padding-right: 0.5rem;
      }

      .message-body::-webkit-scrollbar {
        width: 4px;
      }

      .message-body::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
      }

      /* EMPTY / LOADING STATES */
      .empty-state,
      .loading-state {
        text-align: center;
        padding: 4rem 2rem;
        background: rgba(255, 255, 255, 0.01);
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
      }

      .empty-icon,
      .loading-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid var(--border);
        border-radius: 50%;
        font-size: 1.4rem;
      }

      .empty-title,
      .loading-title {
        font-size: 1.15rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
      }

      .empty-desc,
      .loading-desc {
        font-size: 0.875rem;
        color: var(--text-muted);
        max-width: 280px;
        margin: 0 auto;
      }

      .loading-dots {
        display: inline-flex;
        gap: 0.4rem;
        margin-top: 1rem;
      }

      .loading-dot {
        width: 6px;
        height: 6px;
        background: var(--accent-violet);
        border-radius: 50%;
        animation: loadingDot 1.4s ease-in-out infinite;
      }
      .loading-dot:nth-child(2) { animation-delay: 0.2s; }
      .loading-dot:nth-child(3) { animation-delay: 0.4s; }

      @keyframes loadingDot {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
      }

      /* FOOTER */
      footer {
        background: rgba(5, 5, 8, 0.5);
        backdrop-filter: blur(20px);
        border-top: 1px solid var(--border);
        padding: 2.5rem 2rem;
        margin-top: 6rem;
      }

      .footer-content {
        max-width: 1300px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .footer-text {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
      }

      .footer-links {
        display: flex;
        gap: 1.5rem;
      }

      .footer-links a {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text-muted);
        text-decoration: none;
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--accent-blue);
      }

      @media (max-width: 1024px) {
        .main-grid {
          grid-template-columns: 1fr;
          gap: 3rem;
        }
        .left-panel {
          position: static;
        }
      }

      @media (max-width: 768px) {
        #hero { padding: 6rem 1rem 2rem; min-height: auto; }
        #guestbook { padding: 1rem 1rem 4rem; }
        .guestbook-form { padding: 1.75rem; }
        .message-card { padding: 1.25rem; gap: 1rem; }
        .message-meta-bar { flex-direction: column; align-items: flex-start; gap: 0.25rem; }
        .message-badge-zone { width: 100%; justify-content: flex-end; }
        .footer-content { flex-direction: column; gap: 1rem; text-align: center; }
      }
    </style>
  </head>
  <body>
    <div id="cursor"></div>
    <div id="cursor-follower"></div>
    <div id="grid-bg"></div>
    <div id="gradient-orbs">
      <div class="orb orb-1"></div>
      <div class="orb orb-2"></div>
      <div class="orb orb-3"></div>
    </div>
    <div id="noise-overlay"></div>

    <Navbar activePage="guestbook" />

    <div id="content-wrapper">
      <!-- HERO SECTION -->
      <section id="hero">
        <div class="hero-content">
          <div class="hero-badge">Guestbook</div>
          <h1 class="hero-title">
            <span>留言板</span>
          </h1>
          <p class="hero-description">
            欢迎留下你的想法、筑建更美的星河。每一条留声我都会细细品读。
          </p>
          <div class="hero-stats">
            <div class="stat-item">
              <div class="stat-value" id="hero-messages-count">0</div>
              <div class="stat-label">Total Messages</div>
            </div>
            <div class="stat-item">
              <div class="stat-value">∞</div>
              <div class="stat-label">Connection</div>
            </div>
          </div>
        </div>
      </section>

      <!-- MAIN CONTENT SECTION -->
      <main id="guestbook">
        <div class="main-grid">
          
          <!-- LEFT PANEL -->
          <div class="left-panel">
            <h2 class="panel-title">Hanshan's Space</h2>
            <p class="panel-description">
              这里是思维与创意的碰撞地。你可以在这里匿名提议、吐槽、或是单纯留下今天的足迹。
            </p>
            <p class="atmosphere-text">
              “千江有水千江月，万里无云万里天。” —— 愿你在此自得其乐。
            </p>
            <div class="online-indicator">
              <div class="online-dot"></div>
              <div class="online-text">Online - 随时欢迎留言</div>
            </div>
            <div class="social-links">
              <a href="#" class="social-link" title="GitHub">GH</a>
              <a href="#" class="social-link" title="Twitter">TW</a>
              <a href="#" class="social-link" title="Email">EM</a>
            </div>
          </div>

          <!-- RIGHT PANEL -->
          <div class="right-panel">
            
            <!-- 表单提交 -->
            <form class="guestbook-form" id="message-form">
              <div class="form-header">
                <div class="form-icon">✍️</div>
                <div>
                  <h3 class="form-title">写下留言</h3>
                  <p class="form-subtitle">分享你的想法</p>
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="username">
                  昵称 <span class="required">*</span>
                </label>
                <input type="text" id="username" class="form-input" placeholder="匿名旅者..." required maxlength="20" />
              </div>

              <div class="form-group">
                <label class="form-label" for="email">
                  邮箱 <span class="required">*</span>
                </label>
                <input type="email" id="email" class="form-input" placeholder="your@email.com" required maxlength="100" />
              </div>

              <div class="form-group">
                <label class="form-label" for="content">
                  传达的内容 <span class="required">*</span>
                </label>
                <textarea id="content" class="form-textarea" placeholder="在此处输入你想留下的文字..." required maxlength="500"></textarea>
                <div class="char-counter">
                  <span class="char-count" id="char-counter">0 / 500</span>
                </div>
              </div>

              <button type="submit" class="submit-btn" id="submit-button">
                <div class="btn-content">
                  <span class="btn-loading" id="btn-spinner"></span>
                  <span>发布留言</span>
                </div>
              </button>

              <div class="form-message" id="form-status-msg"></div>
            </form>

            <!-- 留言列表展示 -->
            <section class="messages-section">
              <div class="messages-header">
                <div class="messages-title">
                  所有留言
                  <span class="messages-count" id="list-messages-count">0</span>
                </div>
                <button class="refresh-btn" id="refresh-button">
                  <span class="refresh-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M23 4v6h-6M1 20v-6h6M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>
                    </svg>
                  </span>
                  <span>刷新</span>
                </button>
              </div>

              <!-- 动态容器 -->
              <div id="messages-container">
                <div class="loading-state">
                  <div class="loading-icon">⏳</div>
                  <h4 class="loading-title">正在加载</h4>
                  <p class="loading-desc">正在获取留言数据...</p>
                  <div class="loading-dots">
                    <div class="loading-dot"></div>
                    <div class="loading-dot"></div>
                    <div class="loading-dot"></div>
                  </div>
                </div>
              </div>
            </section>

          </div>
        </div>
      </main>

      <!-- FOOTER -->
      <footer>
        <div class="footer-content">
          <div class="footer-text">© 2026 Hanshan. Designed with Elegance.</div>
          <div class="footer-links">
            <a href="/">Home</a>
            <a href="/posts">Blog</a>
          </div>
        </div>
      </footer>
    </div>

    <!-- 客户端核心交互与通信 JS -->
    <script>
      // 1. 自定义高级光标跟随效果
      const cursor = document.getElementById('cursor');
      const follower = document.getElementById('cursor-follower');
      
      if (cursor && follower) {
        let mouseX = 0, mouseY = 0;
        let followerX = 0, followerY = 0;

        window.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          cursor.style.left = mouseX + 'px';
          cursor.style.top = mouseY + 'px';
        });

        const renderCursor = () => {
          followerX += (mouseX - followerX) * 0.10;
          followerY += (mouseY - followerY) * 0.10;
          follower.style.left = followerX + 'px';
          follower.style.top = followerY + 'px';
          requestAnimationFrame(renderCursor);
        };
        renderCursor();

        const interactiveElements = document.querySelectorAll('a, button, input, textarea');
        interactiveElements.forEach(el => {
          el.addEventListener('mouseenter', () => {
            follower.style.transform = 'translate(-50%, -50%) scale(1.4)';
            follower.style.borderColor = 'var(--accent-violet)';
            cursor.style.width = '10px';
            cursor.style.height = '10px';
          });
          el.addEventListener('mouseleave', () => {
            follower.style.transform = 'translate(-50%, -50%) scale(1)';
            follower.style.borderColor = 'rgba(255, 255, 255, 0.15)';
            cursor.style.width = '8px';
            cursor.style.height = '8px';
          });
        });
      }

      // 2. 核心业务对接
      const API_BASE_URL = '/api/guestbook'; 

      const form = document.getElementById('message-form') as HTMLFormElement;
      const contentInput = document.getElementById('content') as HTMLTextAreaElement;
      const charCounter = document.getElementById('char-counter');
      const submitBtn = document.getElementById('submit-button') as HTMLButtonElement;
      const btnSpinner = document.getElementById('btn-spinner');
      const statusMsg = document.getElementById('form-status-msg');
      const refreshBtn = document.getElementById('refresh-button');
      const container = document.getElementById('messages-container');
      
      const heroCountEl = document.getElementById('hero-messages-count');
      const listCountEl = document.getElementById('list-messages-count');

      // 实时计算字数
      contentInput?.addEventListener('input', () => {
        const len = contentInput.value.length;
        if (charCounter) {
          charCounter.textContent = `${len} / 500`;
          if (len >= 480) charCounter.classList.add('limit');
          else charCounter.classList.remove('limit');
        }
      });

      // 随机渐变色池
      const gradients = [
        'linear-gradient(135deg, #8b5cf6, #ec4899)',
        'linear-gradient(135deg, #06b6d4, #3b82f6)',
        'linear-gradient(135deg, #f59e0b, #e11d48)',
        'linear-gradient(135deg, #10b981, #059669)',
        'linear-gradient(135deg, #d946ef, #8b5cf6)'
      ];

      function getAvatarGradient(name: string) {
        if (!name) return gradients[0];
        let sum = 0;
        for (let i = 0; i < name.length; i++) sum += name.charCodeAt(i);
        return gradients[sum % gradients.length];
      }

      // 拉取数据并重新渲染
      async function fetchMessages() {
        if (!container) return;
        refreshBtn?.classList.add('spinning');
        if (refreshBtn) (refreshBtn as HTMLButtonElement).disabled = true;

        try {
          const res = await fetch(API_BASE_URL);
          if (!res.ok) throw new Error('Network error');
          const result = await res.json();
          const data = result.messages || [];

          if (heroCountEl) heroCountEl.textContent = data.length.toString();
          if (listCountEl) listCountEl.textContent = data.length.toString();

          if (data.length === 0) {
            container.innerHTML = `
              <div class="empty-state">
                <div class="empty-icon">✏️</div>
                <h4 class="empty-title">还没有留言</h4>
                <p class="empty-desc">来做第一个留言的人吧！</p>
              </div>`;
            return;
          }

          container.innerHTML = `
            <div class="messages-list">
              ${data.map((msg: any, index: number) => {
                const dateStr = new Date(msg.created_at).toLocaleDateString('zh-CN', {
                  month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
                });
                const nickname = msg.nickname || '匿名旅者';
                const avatarGrad = getAvatarGradient(nickname);
                const displayIndex = `#${data.length - index}`;

                return `
                  <div class="message-card" style="animation: fadeInUp 0.5s ease forwards; animation-delay: ${index * 0.04}s">
                    <div class="message-avatar-zone">
                      <div class="message-avatar" style="background: ${avatarGrad}">
                        ${nickname.substring(0, 2).toUpperCase()}
                      </div>
                      <div class="avatar-glow" style="background: ${avatarGrad}"></div>
                    </div>
                    
                    <div class="message-detail">
                      <div class="message-meta-bar">
                        <div class="message-user-info">
                          <span class="message-nickname">${nickname}</span>
                          ${msg.email ? `<span class="message-via" title="${msg.email}">${msg.email}</span>` : ''}
                        </div>
                        <div class="message-badge-zone">
                          <span class="message-floor">${displayIndex}</span>
                          <span class="message-split">|</span>
                          <span class="message-time">${dateStr}</span>
                        </div>
                      </div>
                      <div class="message-body">${msg.content}</div>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          `;

        } catch (err) {
          container.innerHTML = `
            <div class="empty-state" style="border-color: rgba(239,68,68,0.15)">
              <div class="empty-icon">⚠️</div>
              <h4 class="empty-title" style="color: #ef4444">量子同步中断</h4>
              <p class="empty-desc">无法获取远端数据，请确保后端 API 正常或已在 script 中更换你的真实 API 终点。</p>
            </div>`;
        } finally {
          setTimeout(() => {
            refreshBtn?.classList.remove('spinning');
            if (refreshBtn) (refreshBtn as HTMLButtonElement).disabled = false;
          }, 500);
        }
      }

      // 拦截提交
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const nameInput = document.getElementById('username') as HTMLInputElement;
        const emailInput = document.getElementById('email') as HTMLInputElement;

        const payload = {
          nickname: nameInput.value.trim(),
          email: emailInput.value.trim(),
          content: contentInput.value.trim()
        };

        submitBtn.disabled = true;
        if (btnSpinner) btnSpinner.style.display = 'block';
        if (statusMsg) { statusMsg.className = 'form-message'; statusMsg.textContent = ''; }

        try {
          const res = await fetch(API_BASE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (!res.ok) {
            const errorData = await res.json();
            throw new Error(errorData.error || 'Unknown error');
          }

          showStatusMessage('留言已成功向服务器同步。', 'success');
          form.reset();
          if (charCounter) charCounter.textContent = '0 / 500';
          await fetchMessages();

        } catch (err: any) {
          showStatusMessage(err.message || '发射失败，链路遭遇未知错误阻截。', 'error');
        } finally {
          submitBtn.disabled = false;
          if (btnSpinner) btnSpinner.style.display = 'none';
        }
      });

      function showStatusMessage(text: string, type: 'success' | 'error') {
        if (!statusMsg) return;
        statusMsg.textContent = text;
        statusMsg.className = `form-message visible ${type}`;
        setTimeout(() => { statusMsg.className = 'form-message'; }, 4000);
      }

      refreshBtn?.addEventListener('click', fetchMessages);
      document.addEventListener('DOMContentLoaded', fetchMessages);
    </script>
  </body>
</html>