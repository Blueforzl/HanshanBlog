</style>

<script>
  // ─── THEME TOGGLE ─────────────────────────────────────────────
  const themes = {
    dark: {
      '--bg-primary': '#050505',
      '--bg-secondary': '#0B0B0D',
      '--bg-card': 'rgba(255, 255, 255, 0.03)',
      '--bg-card-hover': 'rgba(255, 255, 255, 0.05)',
      '--border': 'rgba(255, 255, 255, 0.08)',
      '--border-hover': 'rgba(255, 255, 255, 0.15)',
      '--text-primary': '#F5F5F5',
      '--text-secondary': '#D4D4D8',
      '--text-muted': '#A1A1AA',
      '--text-subtle': '#71717A',
      '--accent-blue': '#60A5FA',
      '--accent-violet': '#8B5CF6',
      '--accent-cyan': '#22D3EE',
      '--gradient': 'linear-gradient(135deg, #60A5FA, #8B5CF6, #22D3EE)',
      '--gradient-text': 'linear-gradient(135deg, #60A5FA, #8B5CF6)',
    },
    light: {
      '--bg-primary': '#FFFFFF',
      '--bg-secondary': '#F8F9FA',
      '--bg-card': 'rgba(0, 0, 0, 0.02)',
      '--bg-card-hover': 'rgba(0, 0, 0, 0.04)',
      '--border': 'rgba(0, 0, 0, 0.08)',
      '--border-hover': 'rgba(0, 0, 0, 0.12)',
      '--text-primary': '#1A1A1A',
      '--text-secondary': '#4A5568',
      '--text-muted': '#718096',
      '--text-subtle': '#A0AEC0',
      '--accent-blue': '#3182CE',
      '--accent-violet': '#805AD5',
      '--accent-cyan': '#0BC5EA',
      '--gradient': 'linear-gradient(135deg, #3182CE, #805AD5, #0BC5EA)',
      '--gradient-text': 'linear-gradient(135deg, #3182CE, #805AD5)',
    },
  };

  function setTheme(themeName) {
    const root = document.documentElement;
    const colors = themes[themeName] || themes.dark;
    Object.entries(colors).forEach(([key, value]) => {
      root.style.setProperty(key, value);
    });
    localStorage.setItem('theme', themeName);
    const icon = document.getElementById('theme-icon');
    if (icon) icon.textContent = themeName === 'dark' ? '🌙' : '☀️';
  }

  const savedTheme = localStorage.getItem('theme') || 'dark';
  setTheme(savedTheme);

  const themeToggle = document.getElementById('theme-toggle');
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const current = localStorage.getItem('theme') || 'dark';
      const newTheme = current === 'dark' ? 'light' : 'dark';
      setTheme(newTheme);
    });
  }

  // ─── SHADER BACKGROUND ───────────────────────────────────────────
  const sc = document.getElementById('shader-canvas');
  const sgl = sc.getContext('webgl') || sc.getContext('experimental-webgl');

  function resizeShader() {
    sc.width = innerWidth;
    sc.height = innerHeight;
    if (sgl) sgl.viewport(0, 0, sc.width, sc.height);
  }
  resizeShader();
  window.addEventListener('resize', resizeShader);

  if (sgl) {
    const gl = sgl;
    const vs = `attribute vec2 p;void main(){gl_Position=vec4(p,0,1);}`;
    const fs = `precision highp float;
uniform float t;uniform vec2 r;uniform vec2 m;
vec3 pal(float t,vec3 a,vec3 b,vec3 c,vec3 d){return a+b*cos(6.28318*(c*t+d));}
float n(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5);}
float sn(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.-2.*f);return mix(mix(n(i),n(i+vec2(1,0)),f.x),mix(n(i+vec2(0,1)),n(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*sn(p);p=p*2.1+vec2(1.7,9.2);a*=.5;}return v;}
void main(){
  vec2 uv=(gl_FragCoord.xy-.5*r)/min(r.x,r.y);
  vec2 mu=(m/r-.5)*2.;
  float time=t*.2;
  vec2 q=vec2(fbm(uv+vec2(0,0)),fbm(uv+vec2(5.2,1.3)));
  vec2 p2=uv+.5*q+vec2(1.7+sin(time*.5)*mu.x*.2,9.2+cos(time*.3)*mu.y*.2);
  float f=fbm(p2);
  vec3 col=pal(f+time*.05,vec3(.3,.3,.4),vec3(.2,.2,.3),vec3(.8,.8,1.),vec3(0,.1,.2));
  col=mix(col,vec3(.2,.1,.3),clamp(f*f*2.,0.,1.));
  col*=1.-length(uv)*.3;
  gl_FragColor=vec4(col*.25,1);
}`;

    function mkShader(gl, type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    }

    const prog = gl.createProgram();
    gl.attachShader(prog, mkShader(gl, gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, mkShader(gl, gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const tl = gl.getUniformLocation(prog, 't');
    const rl = gl.getUniformLocation(prog, 'r');
    const ml = gl.getUniformLocation(prog, 'm');

    let mx = 0,
      my = 0;
    document.addEventListener('mousemove', (e) => {
      mx = e.clientX;
      my = e.clientY;
    });

    function animShader(ts) {
      gl.uniform1f(tl, ts * 0.001);
      gl.uniform2f(rl, sc.width, sc.height);
      gl.uniform2f(ml, mx, my);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      requestAnimationFrame(animShader);
    }
    requestAnimationFrame(animShader);
  }

  // ─── PARTICLE SYSTEM ────────────────────────────────────────────
  const pc = document.getElementById('particle-canvas');
  const ctx = pc.getContext('2d');

  function resizePc() {
    pc.width = innerWidth;
    pc.height = innerHeight;
  }
  resizePc();
  window.addEventListener('resize', resizePc);

  const PARTICLE_COLORS = ['#60A5FA', '#8B5CF6', '#22D3EE'];
  const N = 60;
  const particles = Array.from({ length: N }, () => ({
    x: Math.random() * innerWidth,
    y: Math.random() * innerHeight,
    vx: (Math.random() - 0.5) * 0.2,
    vy: (Math.random() - 0.5) * 0.2,
    r: Math.random() * 1.5 + 0.5,
    c: PARTICLE_COLORS[Math.floor(Math.random() * PARTICLE_COLORS.length)],
    o: Math.random() * 0.3 + 0.1,
  }));

  let pmx = 0,
    pmy = 0;
  document.addEventListener('mousemove', (e) => {
    pmx = e.clientX;
    pmy = e.clientY;
  });

  function animParticles() {
    ctx.clearRect(0, 0, pc.width, pc.height);
    particles.forEach((p) => {
      const dx = pmx - p.x;
      const dy = pmy - p.y;
      const d = Math.sqrt(dx * dx + dy * dy);

      if (d < 120) {
        p.vx += (dx / d) * 0.03;
        p.vy += (dy / d) * 0.03;
      }

      p.vx *= 0.98;
      p.vy *= 0.98;
      p.x += p.vx;
      p.y += p.vy;

      if (p.x < 0) p.x = pc.width;
      if (p.x > pc.width) p.x = 0;
      if (p.y < 0) p.y = pc.height;
      if (p.y > pc.height) p.y = 0;

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = p.c;
      ctx.globalAlpha = p.o;
      ctx.fill();
    });

    ctx.globalAlpha = 1;
    for (let i = 0; i < N; i++) {
      for (let j = i + 1; j < N; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const d = Math.sqrt(dx * dx + dy * dy);

        if (d < 80) {
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = particles[i].c;
          ctx.globalAlpha = (1 - d / 80) * 0.06;
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
    ctx.globalAlpha = 1;
    requestAnimationFrame(animParticles);
  }
  animParticles();

  // ─── CURSOR ANIMATION ───────────────────────────────────────────
  const cur = document.getElementById('cursor');
  const fol = document.getElementById('cursor-follower');
  if (cur && fol) {
    let fx = 0,
      fy = 0,
      cx2 = 0,
      cy2 = 0;

    document.addEventListener('mousemove', (e) => {
      cx2 = e.clientX;
      cy2 = e.clientY;
      cur.style.left = cx2 + 'px';
      cur.style.top = cy2 + 'px';
    });

    function animCursor() {
      fx += (cx2 - fx) * 0.10;
      fy += (cy2 - fy) * 0.10;
      fol.style.left = fx + 'px';
      fol.style.top = fy + 'px';
      requestAnimationFrame(animCursor);
    }
    animCursor();

    document.querySelectorAll('a, button, input, textarea').forEach((el) => {
      el.addEventListener('mouseenter', () => {
        fol.style.transform = 'translate(-50%, -50%) scale(1.4)';
        fol.style.borderColor = 'var(--accent-violet)';
        cur.style.width = '10px';
        cur.style.height = '10px';
      });
      el.addEventListener('mouseleave', () => {
        fol.style.transform = 'translate(-50%, -50%) scale(1)';
        fol.style.borderColor = 'rgba(255, 255, 255, 0.15)';
        cur.style.width = '8px';
        cur.style.height = '8px';
      });
    });
  }

  // ─── MAGNETIC EFFECT ────────────────────────────────────────────
  document.querySelectorAll('.magnetic:not(.logo)').forEach((el) => {
    el.addEventListener('mousemove', (e) => {
      const rect = el.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      el.style.transform = `translate(${x * 0.3}px, ${y * 0.3}px)`;
    });
    el.addEventListener('mouseleave', () => {
      el.style.transform = 'translate(0, 0)';
    });
  });

  // ─── THUMBNAIL CANVASES ─────────────────────────────────────────
  document.querySelectorAll('.thumb-canvas').forEach((c) => {
    const hue = +c.dataset.hue;
    const spd = +c.dataset.speed;
    c.width = c.offsetWidth;
    c.height = c.offsetHeight;
    const cx = c.getContext('2d');
    let t = 0;

    function drawThumb() {
      cx.clearRect(0, 0, c.width, c.height);
      for (let i = 0; i < 3; i++) {
        const x = c.width / 2 + Math.sin(t * spd + i * 1.5) * (c.width * 0.3);
        const y = c.height / 2 + Math.cos(t * spd * 0.8 + i * 1.2) * (c.height * 0.2);
        const r = c.width * 0.25 + Math.sin(t + i) * (c.width * 0.1);
        const gradient = cx.createRadialGradient(x, y, 0, x, y, r);
        gradient.addColorStop(0, `hsla(${hue + i * 30}, 70%, 60%, 0.25)`);
        gradient.addColorStop(1, `hsla(${hue + i * 30}, 70%, 60%, 0)`);
        cx.beginPath();
        cx.arc(x, y, r, 0, Math.PI * 2);
        cx.fillStyle = gradient;
        cx.fill();
      }
      t += 0.006;
      requestAnimationFrame(drawThumb);
    }
    drawThumb();
  });

  // ─── LAB CANVASES ───────────────────────────────────────────────
  document.querySelectorAll('.lab-canvas').forEach((c) => {
    const type = c.dataset.type;
    c.width = c.offsetWidth;
    c.height = c.offsetHeight;
    const cx = c.getContext('2d');
    let t = 0;

    function drawLab() {
      cx.clearRect(0, 0, c.width, c.height);

      if (type === 'flow') {
        for (let i = 0; i < 5; i++) {
          const x = (c.width / 6) * (i + 1);
          const y = c.height / 2 + Math.sin(t * 0.5 + i * 0.8) * 30;
          const gradient = cx.createLinearGradient(x - 30, y, x + 30, y);
          gradient.addColorStop(0, 'rgba(96, 165, 250, 0)');
          gradient.addColorStop(0.5, 'rgba(96, 165, 250, 0.3)');
          gradient.addColorStop(1, 'rgba(96, 165, 250, 0)');
          cx.beginPath();
          cx.moveTo(x - 50, y);
          cx.quadraticCurveTo(x, y - 20, x, y);
          cx.quadraticCurveTo(x, y + 20, x + 50, y);
          cx.strokeStyle = gradient;
          cx.lineWidth = 2;
          cx.stroke();
        }
      } else if (type === 'particles') {
        for (let i = 0; i < 20; i++) {
          const x = ((Math.sin(t * 0.3 + i * 0.5) + 1) * c.width) / 2;
          const y = ((Math.cos(t * 0.4 + i * 0.7) + 1) * c.height) / 2;
          const r = 2 + Math.sin(t + i) * 1;
          cx.beginPath();
          cx.arc(x, y, r, 0, Math.PI * 2);
          cx.fillStyle = `rgba(139, 92, 246, ${0.3 + Math.sin(t + i) * 0.2})`;
          cx.fill();
        }
      } else if (type === 'noise') {
        for (let y = 0; y < c.height; y += 4) {
          cx.beginPath();
          cx.moveTo(0, y);
          for (let x = 0; x < c.width; x += 4) {
            const noise = Math.sin(x * 0.02 + t * 0.01) * Math.cos(y * 0.02 + t * 0.01);
            cx.lineTo(x, y + noise * 10);
          }
          cx.strokeStyle = 'rgba(34, 211, 238, 0.2)';
          cx.lineWidth = 1;
          cx.stroke();
        }
      }

      t += 0.016;
      requestAnimationFrame(drawLab);
    }
    drawLab();
  });

  // ─── SCROLL REVEAL ──────────────────────────────────────────────
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('visible');
          }, index * 100);
          io.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -50px 0px' },
  );

  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
