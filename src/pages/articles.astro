    <footer>
      <div class="footer-content">
        <span class="footer-text">© 2026 Conor Liu. Built with code & coffee.</span>
        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/articles">Blog</a>
          <a href="/projects">Projects</a>
