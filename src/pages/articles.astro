    <div id="cursor-follower"></div>

    <canvas id="shader-canvas"></canvas>
    <canvas id="particle-canvas"></canvas>

    <nav class="navbar">
      <div class="nav-container">
        <a href="/" class="logo magnetic">CL</a>
        <ul class="nav-links">
          <li><a href="/" class="nav-link">Home</a></li>
          <li><a href="/articles" class="nav-link active">Blog</a></li>
          <li><a href="/projects" class="nav-link">Projects</a></li>
          <li><a href="/lab" class="nav-link">Lab</a></li>
          <li><a href="/about" class="nav-link">About</a></li>
        </ul>
        <div class="nav-status">
          <span class="status-dot"></span>
          <span class="status-text">Available</span>
        </div>
      </div>
    </nav>

    <section id="hero">
      <div class="hero-content">
        <div class="hero-badge">WRITING</div>
        <h1 class="hero-title">
          <span class="hero-line">技术</span>
          <span class="hero-line">文章</span>
        </h1>
        <p class="hero-description">
          探索前端工程化、人工智能集成与全栈架构的平衡之美。记录每一次技术栈的迭代与思考。
        </p>
      </div>
    </section>

